---
import '../styles/global.css';
import TopBar, { type Page } from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.astro';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang; current?: Page; title?: string; description?: string; wide?: boolean }
const { lang, current, title, description, wide = false } = Astro.props;
const d = t(lang);
const alt = lang === 'en' ? { lang: 'zh-Hant-TW', path: '/zh' } : { lang: 'en', path: '' };
const bare = Astro.url.pathname.replace(/^\/zh(?=\/)/, '');
---
<!doctype html>
<html lang={d.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? d.meta.title}</title>
    <meta name="description" content={description ?? d.meta.description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang={alt.lang} href={new URL(alt.path + bare, Astro.site)} />
    <meta property="og:title" content={title ?? d.meta.title} />
    <meta property="og:description" content={description ?? d.meta.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet" />
    <script is:inline>
      // Theme before first paint: saved choice, else the OS preference.
      (function () {
        var saved = localStorage.getItem('theme');
        var dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.documentElement.classList.add('js-reveal');
      })();
    </script>
  </head>
  <body>
    <div class={wide ? 'landing-shell' : 'portfolio-shell'}>
      {!wide && <Sidebar lang={lang} />}
      <div class="content-panel">
        <TopBar lang={lang} current={current} />
        <slot />
        <Footer lang={lang} />
      </div>
    </div>
    <script>
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
<style is:global>
  .portfolio-shell { width: min(1200px, calc(100% - 40px)); margin: 48px auto; display: grid; grid-template-columns: 275px minmax(0, 1fr); gap: 24px; align-items: start; }
  .content-panel { min-width: 0; background: var(--card); border-radius: var(--radius-card); padding: 24px; }
  .content-panel > main { display: flex; flex-direction: column; gap: 28px; }
  .content-panel > main > .card { box-shadow: none; padding: 0; border-radius: 0; }
  .topbar nav { display: flex; justify-content: flex-end; }
  @media(max-width: 999px) { .portfolio-shell { grid-template-columns: 1fr; margin-block: 24px 90px; } }
  .landing-shell { width: min(1200px, calc(100% - 40px)); margin: 32px auto; }
  .landing-shell > .content-panel { padding: 24px 28px; }
  @media(max-width: 640px) { .landing-shell { width: calc(100% - 24px); margin-block: 16px 90px; } .landing-shell > .content-panel { padding: 20px 16px; } }
  @media(max-width: 640px) {
    .portfolio-shell { width: calc(100% - 24px); gap: 16px; }
    .content-panel { padding: 20px 16px; }
    .topbar nav { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; background: var(--card); border-top: 1px solid var(--line); padding: 10px 6px max(10px, env(safe-area-inset-bottom)); margin: 0; justify-content: center; }
    .topbar nav ul { gap: 0; justify-content: center; }
    .topbar nav a { padding: 8px 7px; font-size: .72rem; }
  }
</style>
