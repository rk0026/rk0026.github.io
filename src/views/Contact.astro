---
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const c = d.contactPage;
const mailto = `mailto:abc751202@gmail.com?subject=${encodeURIComponent(d.contact.mailSubject)}`;
---
<Base lang={lang} current="contact" title={`${c.title} — ${d.footer.rights}`} description={c.intro}>
  <main class="page">
    <section class="card head" data-reveal>
      <h1>{c.title}</h1>
      <p class="muted">{c.intro}</p>
    </section>

    <section class="card actions" aria-label={d.contact.heading} data-reveal style="--i:1">
      <a class="btn" href={mailto}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" /><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" d="m4.5 7.5 7.5 5 7.5-5" /></svg>
        {d.contact.greeting}
      </a>
      <a class="btn" href={d.hero.ctaHref} download>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M12 4v10m-4-3.5 4 4 4-4M5 19.5h14" /></svg>
        {d.hero.cta}
      </a>
    </section>
  </main>
</Base>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  h1 {
    font-size: var(--step-head);
  }

  .head .muted {
    margin-top: 6px;
    max-width: 60ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
</style>
