---
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
import HeroShapes from '../components/HeroShapes.astro';
import { t, href, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
// import.meta.url points into the build output at build time, so resolve from the project root.
const hasPortrait = fs.existsSync(`${process.cwd()}/public/img/me.jpg`);
const repeats = [0, 1, 2];
// One archival picture per destination page (credited in the footer).
const tileImg = {
  about: { src: '/img/marine-field-telephone-switchboard-operator-guadalcanal-circ.jpg', w: 1920, h: 1453, alt: d.notes.photoAlt },
  stack: { src: '/img/1940s-n935-telephone-exchange.jpg', w: 1920, h: 1801, alt: d.stats.photoAlt },
  projects: { src: '/img/kate-shelley-high-bridge-construction-center-facing.jpg', w: 1800, h: 1215, alt: d.work.photoAlt },
  notes: { src: '/img/wac-telephone-switchboard-operators.jpg', w: 1920, h: 1476, alt: d.knowledge.photoAlt },
};
---
<Base lang={lang} current="home">
  <main>
    <section class="hero">
      <HeroShapes />

      <div class="hero-inner">
        <div class="marquee" aria-hidden="true">
          <div class="marquee-track">
            {[0, 1].map(() => (
              <div class="marquee-group">
                {repeats.map(() => <span>{d.home.marquee}</span>)}
              </div>
            ))}
          </div>
        </div>

        <div class="head">
          <h1>{d.home.greeting} <span class="serif">{d.home.name}</span>!</h1>
          <p class="role">{d.home.role}</p>
        </div>

        <figure class="portrait">
          {hasPortrait ? (
            <img src="/img/me.jpg" alt={d.home.photoAlt} width="800" height="1000" decoding="async" />
          ) : (
            <span class="serif initials" role="img" aria-label={d.home.photoAlt}>HL</span>
          )}
        </figure>

        <a class="btn btn--ghost cta" href="mailto:abc751202@gmail.com">{d.home.cta}</a>
      </div>
    </section>

    <section class="container facts">
      <ul>
        {d.home.facts.map((fact, i) => (
          <li data-reveal style={`--i:${i}`}>
            <strong>{fact.value}</strong>
            <span>{fact.label}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="container tiles">
      {d.home.tiles.map((tile, i) => (
        <a class="card tile" href={href(lang, `/${tile.page}/`)} data-reveal style={`--i:${i}`}>
          <img class="tile-img" src={tileImg[tile.page].src} width={tileImg[tile.page].w} height={tileImg[tile.page].h} alt={tileImg[tile.page].alt} loading="lazy" decoding="async" />
          <h2>{tile.title}</h2>
          <span class="arrow" aria-hidden="true">→</span>
          <p>{tile.text}</p>
        </a>
      ))}
    </section>
  </main>
</Base>

<style>
  .hero {
    position: relative;
    overflow: clip;
    background: var(--bg);
    --hero-top: clamp(104px, 13svh, 140px);
    --hero-bottom: clamp(28px, 5svh, 52px);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-rows: 1fr auto 1fr;
    justify-items: center;
    min-height: 100svh;
    padding-block: var(--hero-top) var(--hero-bottom);
  }

  /* Giant word sliding behind the portrait. */
  .marquee {
    position: absolute;
    top: var(--hero-top);
    bottom: var(--hero-bottom);
    left: 0;
    right: 0;
    z-index: 0;
    display: flex;
    align-items: center;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 26s linear infinite;
    will-change: transform;
  }
  .marquee-group { display: flex; flex: none; }
  .marquee span {
    padding-right: 0.12em;
    font-size: 11vw;
    font-weight: 900;
    line-height: 0.82;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  @keyframes marquee-scroll {
    to { transform: translate3d(-50%, 0, 0); }
  }

  .head,
  .portrait,
  .cta { position: relative; z-index: 1; }

  .head {
    grid-row: 1;
    align-self: end;
    margin-bottom: clamp(16px, 3vh, 32px);
    text-align: center;
  }
  h1 { font-size: var(--step-display); }
  .role { margin-top: clamp(8px, 1.4vh, 16px); color: var(--muted); font-size: var(--step-lead); }

  .portrait {
    grid-row: 2;
    display: grid;
    place-items: center;
    width: 300px;
    aspect-ratio: 4 / 5;
    margin: 0;
    border-radius: 40px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow-card);
    transform: rotate(-3deg);
  }
  .portrait img { width: 100%; height: 100%; object-fit: cover; }
  .initials { font-size: clamp(3rem, 7vw, 5rem); line-height: 1; color: var(--ink); }

  .cta { grid-row: 3; align-self: start; margin-top: clamp(20px, 4vh, 44px); }

  .facts { padding-block: clamp(56px, 8vw, 110px) clamp(40px, 6vw, 80px); }
  .facts ul {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 4vw, 56px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .facts li { display: flex; flex-direction: column; gap: 4px; }
  .facts strong {
    font-size: clamp(2rem, 1.2rem + 3vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .facts span { color: var(--muted); }

  .tiles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(16px, 2vw, 28px);
    padding-bottom: var(--section-gap);
  }
  .tile {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 10px 24px;
    text-decoration: none;
    transition: transform 200ms var(--ease), box-shadow 200ms var(--ease);
  }
  .tile h2 { font-size: var(--step-lead); font-weight: 600; letter-spacing: -0.02em; }
  .tile-img {
    grid-column: 1 / -1;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: calc(var(--radius-card) - 12px);
    margin-bottom: 8px;
    filter: grayscale(1);
    transition: filter 300ms var(--ease), transform 400ms var(--ease);
  }
  .tile:hover .tile-img,
  .tile:focus-visible .tile-img { filter: none; }
  .tile .arrow { font-size: 1.35rem; line-height: 1; }
  .tile p { grid-column: 1 / -1; color: var(--muted); }
  .tile:hover,
  .tile:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 26px 60px -22px rgba(70, 60, 180, 0.3), 0 0 0 8px rgba(120, 110, 255, 0.08);
  }

  @media (max-width: 760px) {
    .hero {
      --hero-top: clamp(96px, 16svh, 130px);
      --hero-bottom: 96px;
    }
    .portrait { width: min(200px, 52vw); border-radius: 28px; }
    .facts ul { grid-template-columns: 1fr; gap: 24px; }
    .tiles { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }
</style>
