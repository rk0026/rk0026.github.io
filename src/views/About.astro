---
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const a = d.aboutPage;
---
<Base lang={lang} current="about" title={`${a.title} — ${d.footer.rights}`}>
  <main>
    <header class="container page-head">
      <h1>{a.title}</h1>
      <p>{a.intro}</p>
    </header>

    <section class="container" aria-label={a.title}>
      <ul class="stack">
        {a.paragraphs.map((text, i) => (
          <li class="sheet" data-reveal style={`--i:${i};--tilt:${i % 2 ? '1deg' : '-1.2deg'}`}>
            <p class="card paper">{text}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="container block">
      <h2 class="heading">{a.timelineHeading}</h2>
      <ol class="timeline">
        {a.timeline.map((job) => (
          <li class="stop" data-reveal>
            <p class="period">{job.period}</p>
            <h3 class="org">{job.org}</h3>
            <p class="role">{job.role}</p>
            <ul class="points">
              {job.points.map((point) => <li>{point}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section class="container block">
      <div class="halves">
        <article class="card half" data-reveal>
          <h2 class="heading heading--small">{a.awardHeading}</h2>
          <p>{a.award}</p>
        </article>
        <article class="card half" data-reveal style="--i:1">
          <h2 class="heading heading--small">{a.educationHeading}</h2>
          <p>{a.education}</p>
        </article>
      </div>
    </section>
  </main>
</Base>

<style>
  .stack {
    width: min(100%, 760px);
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .sheet + .sheet {
    margin-top: -24px;
  }

  .sheet {
    position: relative;
  }

  .sheet:hover,
  .sheet:focus-within {
    z-index: 3;
  }

  .paper {
    text-align: center;
    font-size: var(--step-lead);
    line-height: 1.5;
    transform: rotate(var(--tilt, 0deg));
    transition: transform 260ms var(--ease), box-shadow 260ms var(--ease);
  }

  .sheet:hover .paper {
    transform: rotate(0deg) translateY(-6px);
    box-shadow: var(--shadow-card), var(--shadow-float);
  }

  .block {
    margin-top: calc(var(--section-gap) * 0.5);
  }

  .heading {
    font-size: var(--step-head);
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .heading--small {
    font-size: clamp(1.25rem, 1.1rem + 0.8vw, 1.75rem);
    margin-bottom: 12px;
  }

  .timeline {
    --rail: clamp(20px, 3vw, 40px);
    margin: 0;
    padding: 0 0 0 var(--rail);
    list-style: none;
    border-left: 1.5px solid var(--line);
  }

  .stop {
    position: relative;
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 12px 40px;
  }

  .stop + .stop {
    margin-top: clamp(28px, 4vw, 48px);
  }

  .stop::before {
    content: '';
    position: absolute;
    top: 0.5em;
    left: calc(var(--rail) * -1 - 5.5px);
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }

  .period {
    color: var(--accent);
    font-weight: 700;
    font-size: var(--step-small);
    letter-spacing: 0.02em;
  }

  .org {
    font-weight: 700;
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    line-height: 1.25;
  }

  .role {
    color: var(--muted);
    margin-top: 2px;
  }

  .points {
    margin: 10px 0 0;
    padding-left: 1.1em;
  }

  .points li + li {
    margin-top: 4px;
  }

  .points li::marker {
    color: var(--accent);
  }

  .halves {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(16px, 2.5vw, 28px);
  }

  .half p {
    color: var(--muted);
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .stop {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .halves {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .paper {
      transform: rotate(var(--tilt, 0deg));
    }
  }
</style>
