---
import Base from '../layouts/Base.astro';
import { t, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const a = d.aboutPage;
// Monogram tiles follow the fixed timeline order: Delta, Aurora, NTU.
const orgs = [
  { letter: 'D', colour: '#0b5fff' },
  { letter: 'A', colour: '#7c3aed' },
  { letter: lang === 'zh' ? '台' : 'N', colour: '#b91c1c' },
];
---
<Base lang={lang} current="about" title={`${a.title} — ${d.footer.rights}`}>
  <main>
    <section class="card" data-reveal>
      <h1>{a.title}</h1>
      <p class="muted intro">{a.intro}</p>
    </section>

    <section class="card" data-reveal style="--i:1">
      <span class="label">{a.timelineHeading}</span>
      <ol class="jobs">
        {a.timeline.map((job, i) => (
          <li class="inner job">
            <span class="mono" style={`--tile:${orgs[i].colour}`} aria-hidden="true">{orgs[i].letter}</span>
            <div class="job-body">
              <p class="org">{job.org}</p>
              <h2 class="role">{job.role}</h2>
              <ul class="points">
                {job.points.map((point) => <li>{point}</li>)}
              </ul>
              <p class="meta">
                <span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="3" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8 3v4M16 3v4M3.5 10h17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                  {job.period}
                </span>
                <span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" d="M12 21s7-6.1 7-11.5A7 7 0 0 0 5 9.5C5 14.9 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
                  {job.place}
                </span>
              </p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="card" data-reveal style="--i:2">
      <span class="label">{a.educationHeading}</span>
      <div class="inner"><p class="muted prose">{a.education}</p></div>
    </section>

    <section class="card" data-reveal style="--i:3">
      <span class="label">{a.awardHeading}</span>
      <div class="inner"><p class="muted prose">{a.award}</p></div>
    </section>
  </main>
</Base>

<style>
  main { display: flex; flex-direction: column; gap: var(--gap); }

  h1 { font-size: var(--step-head); }
  .intro { margin-top: 6px; font-size: var(--step-lead); }

  .jobs { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }

  .job { display: grid; grid-template-columns: 40px 1fr; gap: 14px; align-items: start; }

  .mono {
    display: grid; place-items: center;
    width: 40px; height: 40px; border-radius: 10px;
    background: var(--tile); color: #fff;
    font-size: 18px; font-weight: 500; line-height: 1;
  }

  .org { font-size: var(--step-small); color: var(--muted); }
  .role { font-size: var(--step-head); }

  .points { margin: 10px 0 0; padding-left: 18px; font-size: var(--step-body); line-height: 1.5; }
  .points li + li { margin-top: 4px; }
  .points li::marker { color: var(--muted); }

  .meta { display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 12px; font-size: var(--step-small); color: var(--muted); }
  .meta span { display: inline-flex; align-items: center; gap: 6px; }
  .meta svg { width: 14px; height: 14px; flex: none; }

  .prose { line-height: 1.55; }
</style>
