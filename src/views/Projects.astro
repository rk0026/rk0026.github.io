---
import Base from '../layouts/Base.astro';
import Pipeline from '../components/Pipeline.astro';
import Stats from '../components/Stats.astro';
import Work from '../components/Work.astro';
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
---
<Base lang={lang} current="projects" title={`${d.projectsPage.title} — ${d.footer.rights}`}>
  <main class="page">
    <section class="card">
      <h1 class="label">{d.projectsPage.title}</h1>
      <p class="intro muted">{d.projectsPage.intro}</p>
    </section>

    <Pipeline lang={lang} />
    <Stats lang={lang} />
    <Work lang={lang} />
  </main>
</Base>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }
</style>
