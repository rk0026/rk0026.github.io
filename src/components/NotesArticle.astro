---
import Base from '../layouts/Base.astro';
import { render, type CollectionEntry } from 'astro:content';
import { t, href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'notes'>;
}

const { lang, entry } = Astro.props;
const d = t(lang);
const { Content } = await render(entry);

const category = entry.id.split('/')[0];
const dateFormat = new Intl.DateTimeFormat(d.htmlLang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Base
  lang={lang}
  current="notes"
  title={`${entry.data.title} — ${d.footer.rights}`}
  description={entry.data.summary}
>
  <main class="article-page">
    <div class="container">
      <div class="article-col">
        <a class="back" href={href(lang, `/notes/${category}/`)}>{d.notes.back}</a>

        <article>
          <header class="head">
            <h1 data-reveal>{entry.data.title}</h1>
            <p class="meta" data-reveal style="--i:1">
              <span>
                {d.notes.published}{' '}
                <time datetime={entry.data.date.toISOString()}>
                  {dateFormat.format(entry.data.date)}
                </time>
              </span>
              {entry.data.tags.length > 0 && <span class="tags">{entry.data.tags.join(' · ')}</span>}
            </p>
          </header>

          <div class="prose" data-reveal style="--i:2">
            <Content />
          </div>
        </article>
      </div>
    </div>
  </main>
</Base>

<style>
  .article-page {
    padding-block: clamp(120px, 14vw, 180px) clamp(48px, 8vw, 120px);
  }

  .article-col {
    max-width: 68ch;
    margin-inline: auto;
  }

  .back {
    display: inline-block;
    font-size: var(--step-small);
    color: var(--muted);
    text-decoration: none;
    transition: color 180ms var(--ease);
  }
  .back:hover {
    color: var(--ink);
  }

  .head {
    margin-top: clamp(20px, 3vw, 32px);
  }

  h1 {
    font-size: clamp(2.25rem, 1.5rem + 3.4vw, 4.25rem);
    line-height: 1.02;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: clamp(16px, 2vw, 24px);
    font-size: var(--step-small);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .prose {
    margin-top: clamp(32px, 4vw, 56px);
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    line-height: 1.7;
  }

  .prose :global(p) {
    margin: 1.1em 0;
  }

  .prose :global(h2) {
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.25rem);
    margin: 2.2em 0 0.6em;
    line-height: 1.1;
  }

  .prose :global(h3) {
    font-size: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem);
    margin: 1.8em 0 0.5em;
    line-height: 1.15;
  }

  .prose :global(h2:first-child),
  .prose :global(h3:first-child) {
    margin-top: 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 1.1em 0;
    padding-left: 1.3em;
  }

  .prose :global(li) {
    margin: 0.45em 0;
  }

  .prose :global(li)::marker {
    color: var(--muted);
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(a) {
    text-underline-offset: 0.18em;
    transition: color 180ms var(--ease);
  }

  .prose :global(a:hover) {
    color: var(--accent);
  }

  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding: 1.1em 1.4em;
    border-radius: 20px;
    background: var(--surface);
  }

  .prose :global(blockquote p) {
    margin: 0.4em 0;
  }

  .prose :global(blockquote p:first-child) {
    margin-top: 0;
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(table) {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    margin: 1.6em 0;
    font-size: 0.95em;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.55em 0.8em;
    border-bottom: 1px solid var(--line);
    overflow-wrap: anywhere;
  }

  .prose :global(th) {
    font-weight: 600;
  }

  /* Shiki (github-dark) paints its own dark background inline; only the shape is ours. */
  .prose :global(pre) {
    margin: 1.6em 0;
    padding: 1.1em 1.25em;
    border-radius: 20px;
    background: #24292e;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .prose :global(:not(pre) > code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.88em;
    background: var(--surface);
    padding: 0.1em 0.35em;
    border-radius: 6px;
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
    margin: 1.8em 0;
    border-radius: 20px;
  }

  .prose :global(hr) {
    border: 0;
    height: 0;
    margin: 2.4em 0;
  }
</style>
