---
import Base from '../layouts/Base.astro';
import NotesHeader from './NotesHeader.astro';
import { render, type CollectionEntry } from 'astro:content';
import { t, href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'notes'>;
}

const { lang, entry } = Astro.props;
const d = t(lang);
const { Content } = await render(entry);

const category = entry.id.split('/')[0];
const dateFormat = new Intl.DateTimeFormat(d.htmlLang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Base lang={lang} title={`${entry.data.title} — ${d.footer.rights}`} description={entry.data.summary}>
  <NotesHeader lang={lang} />

  <main class="wrap article">
    <a class="back" href={href(lang, `/notes/${category}/`)}>{d.notes.back}</a>

    <article>
      <header class="head">
        <h1 data-reveal>{entry.data.title}</h1>
        <p class="meta" data-reveal style="--i:1">
          <span>{d.notes.published} <time datetime={entry.data.date.toISOString()}>{dateFormat.format(entry.data.date)}</time></span>
          {entry.data.tags.length > 0 && <span class="tags">{entry.data.tags.join(' · ')}</span>}
        </p>
      </header>

      <div class="prose" data-reveal style="--i:2">
        <Content />
      </div>
    </article>
  </main>
</Base>

<style>
  .article {
    padding-bottom: clamp(64px, 10vw, 160px);
  }

  .back {
    display: inline-block;
    margin-top: clamp(8px, 1.6vw, 20px);
    font-size: var(--step-small);
    color: var(--muted);
    text-decoration: none;
    transition: color 180ms var(--ease);
  }
  .back:hover {
    color: var(--ink);
  }

  .head {
    margin-top: clamp(24px, 4vw, 56px);
  }

  h1 {
    font-size: clamp(2.25rem, 1.5rem + 3.4vw, 4.5rem);
    max-width: 24ch;
    line-height: 0.98;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: clamp(16px, 2vw, 24px);
    font-size: var(--step-small);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .prose {
    max-width: 68ch;
    margin-top: clamp(32px, 4vw, 56px);
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    line-height: 1.7;
  }

  .prose :global(p) {
    margin: 1.1em 0;
  }

  .prose :global(h2) {
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.6rem);
    margin: 2.2em 0 0.6em;
    line-height: 1.05;
  }

  .prose :global(h3) {
    font-size: clamp(1.3rem, 1.15rem + 0.7vw, 1.7rem);
    margin: 1.8em 0 0.5em;
    line-height: 1.1;
  }

  .prose :global(h2:first-child),
  .prose :global(h3:first-child) {
    margin-top: 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 1.1em 0;
    padding-left: 1.3em;
  }

  .prose :global(li) {
    margin: 0.45em 0;
  }

  .prose :global(li)::marker {
    color: var(--muted);
  }

  .prose :global(strong) {
    font-weight: 500;
  }

  .prose :global(a) {
    text-underline-offset: 0.18em;
    transition: color 180ms var(--ease);
  }

  .prose :global(a:hover) {
    color: var(--accent);
  }

  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding: 1.1em 1.4em;
    background: var(--surface);
  }

  .prose :global(blockquote p) {
    margin: 0.4em 0;
  }

  .prose :global(blockquote p:first-child) {
    margin-top: 0;
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(table) {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    margin: 1.6em 0;
    font-size: 0.95em;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.55em 0.8em;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
    overflow-wrap: anywhere;
  }

  .prose :global(th) {
    font-weight: 500;
  }

  .prose :global(pre) {
    margin: 1.6em 0;
    padding: 1.1em 1.2em;
    background: var(--surface) !important;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .prose :global(:not(pre) > code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.88em;
    background: var(--surface);
    padding: 0.1em 0.35em;
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
    margin: 1.8em 0;
  }

  .prose :global(hr) {
    border: 0;
    height: 0;
    margin: 2.4em 0;
  }
</style>
