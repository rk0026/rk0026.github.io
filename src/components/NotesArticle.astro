---
import Base from '../layouts/Base.astro';
import { render, type CollectionEntry } from 'astro:content';
import { t, href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'notes'>;
}

const { lang, entry } = Astro.props;
const d = t(lang);
const { Content } = await render(entry);

const category = entry.id.split('/')[0];
const dateFormat = new Intl.DateTimeFormat(d.htmlLang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Base
  lang={lang}
  current="notes"
  title={`${entry.data.title} — ${d.footer.rights}`}
  description={entry.data.summary}
>
  <main>
    <article class="card" data-reveal>
      <div class="article">
        <header class="head">
          <h1>{entry.data.title}</h1>
          <p class="meta">
            <span class="date">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" d="M8 3v4m8-4v4M3.5 10h17" /></svg>
              <span>{d.notes.published} <time datetime={entry.data.date.toISOString()}>{dateFormat.format(entry.data.date)}</time></span>
            </span>
            {entry.data.tags.length > 0 && <span class="tags">{entry.data.tags.join(' · ')}</span>}
          </p>
        </header>

        <div class="prose">
          <Content />
        </div>

        <a class="btn back" href={href(lang, `/notes/${category}/`)}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m6 6-6-6 6-6" /></svg>
          {d.notes.back}
        </a>
      </div>
    </article>
  </main>
</Base>

<style>
  .article {
    max-width: 68ch;
    margin-inline: auto;
  }

  h1 {
    font-size: var(--step-head);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: 10px;
    font-size: var(--step-small);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .date {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .date svg {
    width: 14px;
    height: 14px;
  }

  .tags {
    overflow-wrap: anywhere;
  }

  .prose {
    margin-top: 24px;
    line-height: 1.7;
  }

  .prose :global(p) {
    margin: 1em 0;
  }

  .prose :global(h2) {
    font-size: 1.375rem;
    margin: 2em 0 0.5em;
  }

  .prose :global(h3) {
    font-size: 1.125rem;
    margin: 1.6em 0 0.4em;
  }

  .prose :global(h2:first-child),
  .prose :global(h3:first-child) {
    margin-top: 0;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 1em 0;
    padding-left: 1.3em;
  }

  .prose :global(li) {
    margin: 0.35em 0;
  }

  .prose :global(li)::marker {
    color: var(--muted);
  }

  .prose :global(strong) {
    font-weight: 600;
  }

  .prose :global(a) {
    text-underline-offset: 0.18em;
  }

  .prose :global(blockquote) {
    margin: 1.4em 0;
    padding: 1em 1.3em;
    border-radius: 18px;
    background: var(--surface);
  }

  .prose :global(blockquote p) {
    margin: 0.35em 0;
  }

  .prose :global(blockquote p:first-child) {
    margin-top: 0;
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.4em 0;
    font-size: 0.9375rem;
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.5em 0.75em;
    border-bottom: 1px solid var(--line);
    overflow-wrap: anywhere;
  }

  .prose :global(th) {
    font-weight: 500;
    color: var(--muted);
  }

  /* Shiki (github-dark) paints its own dark background inline; only the shape is ours. */
  .prose :global(pre) {
    margin: 1.4em 0;
    padding: 1em 1.15em;
    border-radius: 18px;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.65;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .prose :global(:not(pre) > code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.88em;
    background: var(--surface);
    padding: 0.1em 0.35em;
    border-radius: 6px;
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
    margin: 1.6em 0;
    border-radius: 12px;
  }

  .prose :global(hr) {
    border: 0;
    height: 0;
    margin: 2em 0;
  }

  .back {
    margin-top: 28px;
  }
</style>
