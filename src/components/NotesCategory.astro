---
import Base from '../layouts/Base.astro';
import NotesHeader from './NotesHeader.astro';
import { getCollection } from 'astro:content';
import { t, href, type Lang, type Category } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);

const category = Astro.params.category as Category;
const label = d.knowledge.items.find((item) => item.slug === category)?.label ?? category;

const entries = (await getCollection('notes'))
  .filter((entry) => entry.id.startsWith(`${category}/`))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormat = new Intl.DateTimeFormat(d.htmlLang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Base
  lang={lang}
  title={`${label} — ${d.notes.title}`}
  description={d.notes.descriptions[category]}
>
  <NotesHeader lang={lang} />

  <main class="category">
    <div class="wrap">
      <header class="head">
        <h1 data-reveal>{label}</h1>
        <p class="desc" data-reveal style="--i:1">{d.notes.descriptions[category]}</p>
      </header>

      {entries.length > 0 ? (
        <section class="list" aria-labelledby="list-heading">
          <h2 id="list-heading" class="visually-hidden">{label}</h2>
          {entries.map((entry, i) => (
            <a
              class="entry"
              href={href(lang, `/notes/${entry.id}/`)}
              data-reveal
              style={`--i:${i + 2}`}
            >
              <span class="entry-title">{entry.data.title}</span>
              <span class="entry-summary">{entry.data.summary}</span>
              <span class="entry-meta">
                <time datetime={entry.data.date.toISOString()}>
                  {dateFormat.format(entry.data.date)}
                </time>
                {entry.data.tags.length > 0 && (
                  <span class="entry-tags">{entry.data.tags.join(' · ')}</span>
                )}
              </span>
            </a>
          ))}
        </section>
      ) : (
        <section class="empty" aria-labelledby="empty-heading">
          <h2 id="empty-heading" class="visually-hidden">{label}</h2>
          <p class="empty-line" data-reveal style="--i:2">{d.notes.empty}</p>
        </section>
      )}

      <a class="back" href={href(lang, '/notes/')}>{d.notes.back}</a>
    </div>
  </main>
</Base>

<style>
  .category {
    padding-bottom: clamp(64px, 10vw, 160px);
  }

  .back {
    display: inline-block;
    margin-top: clamp(40px, 6vw, 80px);
    font-size: var(--step-small);
    color: var(--muted);
    text-decoration: none;
    transition: color 180ms var(--ease);
  }
  .back:hover {
    color: var(--ink);
  }

  .head {
    margin-top: clamp(24px, 4vw, 56px);
    display: grid;
    gap: clamp(16px, 2vw, 28px);
  }

  h1 {
    font-size: clamp(48px, 6.5vw, 100px);
    font-weight: 300;
    line-height: 0.84;
    letter-spacing: -0.02em;
  }

  .desc {
    font-size: var(--step-lead);
    line-height: 1.35;
    color: var(--muted);
    max-width: 44ch;
  }

  .list {
    margin-top: clamp(32px, 5vw, 72px);
  }

  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26ch);
    gap: 8px clamp(24px, 4vw, 64px);
    align-items: baseline;
    padding-block: clamp(20px, 3vw, 36px);
    text-decoration: none;
  }

  .entry-title {
    grid-column: 1;
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3.25rem);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.015em;
    transition: color 200ms var(--ease), transform 260ms var(--ease);
  }

  .entry:hover .entry-title,
  .entry:focus-visible .entry-title {
    color: var(--accent);
    transform: translateX(6px);
  }

  .entry-summary {
    grid-column: 1;
    color: var(--muted);
    font-size: var(--step-body);
    line-height: 1.5;
    max-width: 56ch;
  }

  .entry-meta {
    grid-column: 2;
    grid-row: 1 / span 2;
    justify-self: end;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: right;
    font-size: var(--step-small);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .empty {
    margin-top: clamp(40px, 8vw, 120px);
    min-height: clamp(300px, 44vh, 520px);
    display: flex;
    align-items: center;
  }

  .empty-line {
    font-size: clamp(24px, 4.6vw, 68px);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.02em;
    max-width: 16ch;
  }

  @media (max-width: 760px) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
    }
    .entry-meta {
      grid-column: 1;
      grid-row: auto;
      justify-self: start;
      text-align: left;
    }
  }
</style>
