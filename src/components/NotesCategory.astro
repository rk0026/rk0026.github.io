---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { t, href, type Lang, type Category } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);

const category = Astro.params.category as Category;
const label = d.knowledge.items.find((item) => item.slug === category)?.label ?? category;

const entries = (await getCollection('notes'))
  .filter((entry) => entry.id.startsWith(`${category}/`))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormat = new Intl.DateTimeFormat(d.htmlLang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Base
  lang={lang}
  current="notes"
  title={`${label} — ${d.notes.title}`}
  description={d.notes.descriptions[category]}
>
  <main class="category">
    <div class="container page-head">
      <h1 data-reveal>{label}</h1>
      <p data-reveal style="--i:1">{d.notes.descriptions[category]}</p>
    </div>

    <div class="container">
      {entries.length > 0 ? (
        <section class="list" aria-labelledby="list-heading">
          <h2 id="list-heading" class="visually-hidden">{label}</h2>
          {entries.map((entry, i) => (
            <a
              class="card entry"
              href={href(lang, `/notes/${entry.id}/`)}
              data-reveal
              style={`--i:${i + 2}`}
            >
              <span class="entry-title">{entry.data.title}</span>
              <span class="entry-summary">{entry.data.summary}</span>
              <span class="entry-meta">
                <time datetime={entry.data.date.toISOString()}>
                  {dateFormat.format(entry.data.date)}
                </time>
                {entry.data.tags.length > 0 && (
                  <span class="entry-tags">{entry.data.tags.join(' · ')}</span>
                )}
                <span class="entry-arrow" aria-hidden="true">↗</span>
              </span>
            </a>
          ))}
          <a class="back" href={href(lang, '/notes/')}>{d.notes.back}</a>
        </section>
      ) : (
        <section class="card empty" aria-labelledby="empty-heading">
          <h2 id="empty-heading" class="visually-hidden">{label}</h2>
          <p class="empty-line" data-reveal style="--i:2">{d.notes.empty}</p>
          <a class="btn btn--ghost" href={href(lang, '/notes/')} data-reveal style="--i:3">
            {d.notes.back}
          </a>
        </section>
      )}
    </div>
  </main>
</Base>

<style>
  .category {
    padding-bottom: clamp(48px, 8vw, 120px);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 2vw, 24px);
  }

  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px clamp(20px, 3vw, 40px);
    align-items: start;
    text-decoration: none;
    transition: transform 200ms var(--ease), box-shadow 200ms var(--ease);
  }

  .entry:hover,
  .entry:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--shadow-float);
  }

  .entry-title {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .entry-summary {
    grid-column: 1;
    color: var(--muted);
    font-size: var(--step-body);
    line-height: 1.55;
    max-width: 62ch;
  }

  .entry-meta {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    text-align: right;
    font-size: var(--step-small);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .entry-arrow {
    transition: transform 200ms var(--ease), color 200ms var(--ease);
  }

  .entry:hover .entry-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .back {
    align-self: flex-start;
    margin-top: clamp(16px, 2vw, 24px);
    font-size: var(--step-small);
    color: var(--muted);
    text-decoration: none;
    transition: color 180ms var(--ease);
  }
  .back:hover {
    color: var(--ink);
  }

  .empty {
    display: flex;
    flex-direction: column;
    max-width: 720px;
    margin-inline: auto;
    align-items: center;
    gap: clamp(20px, 3vw, 32px);
    padding-block: clamp(48px, 7vw, 96px);
    text-align: center;
  }

  .empty-line {
    font-size: var(--step-lead);
    font-weight: 500;
    max-width: 28ch;
  }

  @media (max-width: 760px) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
    }
    .entry-meta {
      grid-column: 1;
      grid-row: auto;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      text-align: left;
    }
    .back {
      align-self: center;
    }
  }
</style>
