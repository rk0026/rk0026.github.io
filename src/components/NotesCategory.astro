---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { t, href, type Lang, type Category } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);

const category = Astro.params.category as Category;
const label = d.knowledge.items.find((item) => item.slug === category)?.label ?? category;

const entries = (await getCollection('notes'))
  .filter((entry) => entry.id.startsWith(`${category}/`))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFormat = new Intl.DateTimeFormat(d.htmlLang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---
<Base
  lang={lang}
  current="notes"
  title={`${label} — ${d.notes.title}`}
  description={d.notes.descriptions[category]}
>
  <main class="page">
    <section class="card head" data-reveal>
      <h1>{label}</h1>
      <p class="muted">{d.notes.descriptions[category]}</p>
    </section>

    {entries.length > 0 ? (
      <section class="card" aria-label={label} data-reveal style="--i:1">
        <ul class="rows">
          {entries.map((entry) => (
            <li>
              <a class="inner row" href={href(lang, `/notes/${entry.id}/`)}>
                <span class="row-main">
                  <span class="row-title">{entry.data.title}</span>
                  <span class="row-summary">{entry.data.summary}</span>
                  <span class="row-meta">
                    <span class="date">
                      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" d="M8 3v4m8-4v4M3.5 10h17" /></svg>
                      <time datetime={entry.data.date.toISOString()}>{dateFormat.format(entry.data.date)}</time>
                    </span>
                    {entry.data.tags.length > 0 && <span class="tags">{entry.data.tags.join(' · ')}</span>}
                  </span>
                </span>
                <span class="icon-btn" aria-hidden="true">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : (
      <section class="card" data-reveal style="--i:1">
        <div class="inner empty">
          <p>{d.notes.empty}</p>
          <a class="btn" href={href(lang, '/notes/')}>{d.notes.back}</a>
        </div>
      </section>
    )}
  </main>
</Base>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  h1 {
    font-size: var(--step-head);
  }

  .head .muted {
    margin-top: 6px;
    max-width: 60ch;
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--gap);
  }

  .row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    text-decoration: none;
  }

  .row-main {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 4px;
  }

  .row-title {
    font-size: var(--step-lead);
  }

  .row-summary {
    color: var(--muted);
    font-size: var(--step-small);
    line-height: 1.55;
  }

  .row-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    font-size: var(--step-small);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .date {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .date svg {
    width: 14px;
    height: 14px;
  }

  .tags {
    overflow-wrap: anywhere;
  }

  .row .icon-btn {
    margin-top: 2px;
    flex: none;
  }

  .row svg {
    width: 16px;
    height: 16px;
  }

  .empty {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    font-size: var(--step-lead);
  }
</style>
