---
import { t, href, type Lang } from '../i18n';

export type Page = 'home' | 'about' | 'stack' | 'projects' | 'notes' | 'contact';
interface Props { lang: Lang; current?: Page }
const { lang, current } = Astro.props;
const d = t(lang);
const items: Array<{ id: Page; path: string }> = [
  { id: 'home', path: '/' },
  { id: 'about', path: '/about/' },
  { id: 'stack', path: '/stack/' },
  { id: 'projects', path: '/projects/' },
  { id: 'notes', path: '/notes/' },
  { id: 'contact', path: '/contact/' },
];
const bare = Astro.url.pathname.replace(/^\/en(?=\/)/, '') || '/';
const switchHref = lang === 'zh' ? `/en${bare}` : bare;
---
<header class="site-nav">
  <nav class="pill" aria-label={d.nav.menu}>
    <ul>
      {items.map((it) => (
        <li>
          <a href={href(lang, it.path)} aria-current={it.id === current ? 'page' : undefined}>{d.nav[it.id]}</a>
        </li>
      ))}
    </ul>
  </nav>
  <a class="pill switch" href={switchHref} hreflang={lang === 'zh' ? 'en' : 'zh-Hant-TW'}>{d.nav.switchLabel}</a>
</header>

<style>
  .site-nav {
    position: fixed;
    inset: 16px 0 auto;
    z-index: 50;
    display: flex;
    justify-content: center;
    gap: 10px;
    padding-inline: var(--margin);
    pointer-events: none;
  }
  .pill {
    pointer-events: auto;
    background: rgba(255, 255, 255, 0.92);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-float);
    padding: 6px;
  }
  ul { display: flex; gap: 2px; margin: 0; padding: 0; list-style: none; }
  a {
    display: block;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 160ms var(--ease), color 160ms var(--ease);
  }
  a:hover { background: var(--surface); }
  a[aria-current='page'] { background: var(--accent); color: var(--accent-ink); }
  .switch { display: flex; align-items: center; padding: 6px; }
  .switch:hover { background: rgba(255, 255, 255, 0.92); }

  @media (max-width: 760px) {
    .site-nav { inset: auto 0 12px; gap: 6px; }
    .pill { padding: 4px; max-width: calc(100vw - 2 * var(--margin) - 56px); overflow-x: auto; scrollbar-width: none; }
    a { padding: 8px 11px; font-size: 0.875rem; }
  }
</style>
