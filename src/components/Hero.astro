---
import { t, href, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const altLang = lang === 'zh' ? 'en' : 'zh-Hant-TW';
---
<section class="hero" id="hero">
  <!-- three.js canvas mounts here (#hero-three) -->
  <div class="three-slot" id="hero-three" aria-hidden="true"></div>

  <div class="hero-inner wrap">
    <header class="top">
      <a class="mark" href={href(lang, '/')}>{d.hero.word}</a>

      <nav class="links">
        <a href="#about">{d.nav.about}</a>
        <a href="#work">{d.nav.work}</a>
        <a href={href(lang, '/notes/')}>{d.nav.notes}</a>
        <a class="switch" href={d.nav.switchHref} hreflang={altLang} lang={altLang}>{d.nav.switchLabel}</a>
      </nav>

      <details class="menu">
        <summary>{d.nav.menu}</summary>
        <nav class="menu-panel">
          <a href="#about">{d.nav.about}</a>
          <a href="#work">{d.nav.work}</a>
          <a href={href(lang, '/notes/')}>{d.nav.notes}</a>
          <a href={d.nav.switchHref} hreflang={altLang} lang={altLang}>{d.nav.switchLabel}</a>
        </nav>
      </details>
    </header>

    <h1 data-reveal>{d.hero.h1}</h1>

    <div class="foot">
      <p class="sentence" data-reveal style="--i:1">{d.hero.sentence}</p>
      <a class="btn" href={d.hero.ctaHref} download data-reveal style="--i:2">{d.hero.cta}</a>
    </div>
  </div>

  <span class="hero-word" aria-hidden="true">{d.hero.word}</span>
</section>

<style>
  .hero {
    --word-size: clamp(240px, 30vw, 480px);
    --reserve: calc(var(--word-size) * 0.84);
    position: relative;
    height: 100svh;
    overflow: clip;
  }

  .three-slot {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 4vh, 56px);
    height: 100%;
    padding-block: var(--margin);
    padding-bottom: calc(var(--reserve) + var(--margin));
  }

  .top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    font-size: var(--step-small);
  }

  .mark {
    font-weight: 500;
    font-size: 0.9375rem;
    letter-spacing: 0.01em;
    text-decoration: none;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(16px, 2.4vw, 36px);
  }

  .links a {
    text-decoration: none;
    transition: color 160ms var(--ease);
  }

  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  .switch {
    color: var(--muted);
  }

  .menu {
    display: none;
  }

  h1 {
    margin-top: clamp(24px, 7vh, 96px);
    font-size: var(--step-head);
    max-width: 26ch;
    font-weight: 300;
  }

  .foot {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(20px, 3vw, 48px);
  }

  .sentence {
    max-width: 32ch;
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    line-height: 1.45;
    color: var(--ink);
  }

  .hero-word {
    position: absolute;
    z-index: 1;
    left: 0;
    bottom: 0;
    font-size: var(--word-size);
    font-weight: 300;
    line-height: 0.8;
    letter-spacing: -0.03em;
    white-space: nowrap;
    transform: translate(-8vw, 6%);
    pointer-events: none;
    user-select: none;
  }

  /* Portrait tablets: a larger crop fills the height, and the sentence stays with the h1. */
  @media (min-width: 701px) and (max-aspect-ratio: 1 / 1) {
    .hero {
      --word-size: clamp(240px, max(30vw, 36svh), 480px);
    }

    .foot {
      margin-top: 0;
    }
  }

  /* Short viewports: keep the word from eating the whole composition. */
  @media (min-width: 701px) and (max-height: 700px) {
    .hero {
      --word-size: clamp(200px, 42svh, 480px);
    }
  }

  @media (max-width: 700px) {
    .hero {
      --reserve: 0px;
    }

    .hero-inner {
      justify-content: flex-start;
      gap: clamp(28px, 5vh, 44px);
      padding-bottom: var(--margin);
    }

    .links {
      display: none;
    }

    .menu {
      display: block;
      position: relative;
    }

    .menu summary {
      list-style: none;
      cursor: pointer;
      padding: 0.2em 0;
    }

    .menu summary::-webkit-details-marker {
      display: none;
    }

    .menu-panel {
      position: absolute;
      top: calc(100% + 12px);
      right: 0;
      z-index: 3;
      display: grid;
      gap: 14px;
      padding: 18px 22px;
      border-radius: 18px;
      background: var(--surface);
      font-size: var(--step-body);
      white-space: nowrap;
    }

    .menu-panel a {
      text-decoration: none;
    }

    h1 {
      max-width: none;
    }

    h1 {
      margin-top: 0;
    }

    .foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      margin-top: 0;
    }

    .sentence {
      max-width: 22ch;
    }

    .hero-word {
      top: 62svh;
      right: calc(var(--margin) * -0.5);
      bottom: auto;
      left: auto;
      writing-mode: vertical-rl;
      font-size: clamp(64px, 16vw, 130px);
      letter-spacing: -0.02em;
      transform: none;
    }
  }
</style>
