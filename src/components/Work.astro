---
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const items = d.work.items;
const first = items[0];
---
<section class="work" id="work">
  <div class="wrap">
    <header class="head">
      <h2 data-reveal>{d.work.heading}</h2>
      <p class="note" data-reveal style="--i:1">{d.work.note}</p>
    </header>

    <div class="shelf" role="group" aria-label={d.work.heading}>
      {items.map((item, i) => (
        <button
          type="button"
          class="spine"
          data-name={item.name}
          data-detail={item.detail}
          title={item.detail}
          aria-pressed={i === 0 ? 'true' : 'false'}
          data-reveal
          style={`--i:${Math.min(i + 2, 10)}`}
        >
          <span class="spine-name">{item.name}</span>
          <span class={`tag tag-${item.disc}`}>{d.work.disciplines[item.disc]}</span>
        </button>
      ))}
    </div>

    <p class="detail" aria-live="polite" aria-atomic="true" data-reveal>
      <span class="detail-name">{first.name}</span>{' '}<span class="detail-text">{first.detail}</span>
    </p>
  </div>

  <img
    class="photo"
    src="/img/kate-shelley-high-bridge-construction-center-facing.jpg"
    width="1800"
    height="1215"
    alt={d.work.photoAlt}
    loading="lazy"
    decoding="async"
    data-reveal
  />
</section>

<script>
  const spines = Array.from(document.querySelectorAll<HTMLButtonElement>('#work .spine'));
  const detailName = document.querySelector<HTMLElement>('#work .detail-name');
  const detailText = document.querySelector<HTMLElement>('#work .detail-text');

  for (const spine of spines) {
    spine.addEventListener('click', () => {
      for (const other of spines) other.setAttribute('aria-pressed', String(other === spine));
      if (detailName) detailName.textContent = spine.dataset.name ?? '';
      if (detailText) detailText.textContent = spine.dataset.detail ?? '';
    });
  }
</script>

<style>
  .work {
    padding-block-start: var(--section-gap);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 18px;
  }
  .head h2 {
    font-size: 28px;
    line-height: 1.1;
  }
  .note {
    font-size: 15px;
    line-height: 1.4;
    color: var(--muted);
  }

  .shelf {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-block-start: clamp(32px, 4vw, 56px);
  }

  .spine {
    flex: 0 0 32px;
    width: 32px;
    height: 420px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 0;
    border: 0;
    border-radius: 0;
    background: var(--surface);
    color: var(--ink);
    writing-mode: vertical-rl;
    text-align: start;
    cursor: pointer;
    transition: background-color 160ms var(--ease), color 160ms var(--ease);
  }

  .spine-name {
    font-size: 18px;
    line-height: 1;
    letter-spacing: 0.01em;
    transition: color 160ms var(--ease);
  }

  .tag {
    font-size: 13px;
    line-height: 1.1;
    letter-spacing: 0.02em;
    padding: 6px 4px;
    border-radius: 0;
  }
  .tag-fe {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .tag-be {
    background: var(--field-2);
    color: var(--field-2-ink);
  }
  .tag-infra {
    background: var(--field-1);
    color: var(--ink);
  }
  .tag-ai {
    background: var(--surface);
    color: var(--ink);
  }
  .tag-sec {
    background: var(--muted);
    color: var(--bg);
  }

  .spine:hover,
  .spine:focus-visible,
  .spine[aria-pressed='true'] {
    background: var(--field-1);
  }
  .shelf:has(.spine:hover) .spine:not(:hover):not([aria-pressed='true']) .spine-name {
    color: var(--muted);
  }

  .detail {
    margin-block-start: clamp(24px, 3vw, 40px);
    max-inline-size: 68ch;
    font-size: var(--step-lead);
    line-height: 1.35;
    color: var(--muted);
  }
  .detail-name {
    margin-inline-end: 0.35em;
    font-weight: 500;
    color: var(--ink);
  }

  .photo {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    margin-block-start: var(--section-gap);
  }

  @media (max-width: 700px) {
    .head {
      display: block;
    }
    .note {
      margin-block-start: 8px;
    }
  }

  /* Horizontal chips at every width: vertical spines were unreadable. */
  .shelf {
    gap: 10px;
    margin-block-start: 28px;
  }
  .spine {
    flex: 0 0 auto;
    width: auto;
    height: auto;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    writing-mode: horizontal-tb;
  }
  .spine-name {
    font-size: 17px;
  }
  .tag {
    padding: 2px 7px;
  }
  .detail {
    margin-block-start: 28px;
  }
</style>
