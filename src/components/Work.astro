---
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const items = d.work.items;
const first = items[0];
---

<section id="work" class="card" aria-labelledby="work-label">
  <span class="label" id="work-label">{d.work.heading}</span>
  <p class="note muted">{d.work.note}</p>

  <div class="shelf" role="group" aria-label={d.work.heading}>
    {items.map((item, i) => (
      <button
        type="button"
        class="chip inner"
        data-name={item.name}
        data-detail={item.detail}
        title={item.detail}
        aria-pressed={i === 0 ? 'true' : 'false'}
        data-reveal
        style={`--i:${Math.min(i + 2, 10)}`}
      >
        <span class="chip-name">{item.name}</span>
        <span class={`tag tag-${item.disc}`}>{d.work.disciplines[item.disc]}</span>
      </button>
    ))}
  </div>

  <p class="detail inner" aria-live="polite" aria-atomic="true">
    <span class="detail-name">{first.name}</span>{' '}<span class="detail-text">{first.detail}</span>
  </p>

  <figure class="photo">
    <img
      src="/img/kate-shelley-high-bridge-construction-center-facing.jpg"
      width="1800"
      height="1215"
      alt={d.work.photoAlt}
      loading="lazy"
      decoding="async"
    />
  </figure>
</section>

<script>
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('#work .chip'));
  const detailName = document.querySelector<HTMLElement>('#work .detail-name');
  const detailText = document.querySelector<HTMLElement>('#work .detail-text');

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      for (const other of chips) other.setAttribute('aria-pressed', String(other === chip));
      if (detailName) detailName.textContent = chip.dataset.name ?? '';
      if (detailText) detailText.textContent = chip.dataset.detail ?? '';
    });
  }
</script>

<style>
  .note {
    font-size: var(--step-small);
  }

  .shelf {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 100%;
    padding: 4px 4px 4px 12px;
    border-radius: var(--radius-pill);
    font-size: var(--step-small);
    line-height: 1.2;
    cursor: pointer;
    transition: background-color 160ms var(--ease), box-shadow 160ms var(--ease);
  }

  .chip:hover {
    background: var(--surface);
  }

  .chip[aria-pressed='true'] {
    box-shadow: 0 0 0 2px var(--accent);
  }

  .chip-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 500;
  }

  .tag {
    flex: 0 0 auto;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.5;
    white-space: nowrap;
  }

  /* Fixed tag colours (design exception, like monogram tiles): dark ink text
     keeps every tag legible on both themes. */
  .tag-fe {
    background: #ff4f00;
  }
  .tag-be {
    background: #4d8dff;
  }
  .tag-infra {
    background: #a98bff;
  }
  .tag-ai {
    background: #c6e85a;
  }
  .tag-sec {
    background: #ffc23d;
  }
  .tag-fe,
  .tag-be,
  .tag-infra,
  .tag-ai,
  .tag-sec {
    color: #111111;
  }

  .detail {
    margin-top: 14px;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .detail-name {
    margin-inline-end: 0.35em;
    font-weight: 500;
    color: var(--ink);
  }

  .photo {
    margin: 14px 0 0;
    overflow: hidden;
    border-radius: var(--radius-inner);
    background: var(--surface);
  }

  .photo img {
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* On narrow screens the pills rarely pair up; let each one fill its row
     instead of leaving ragged space to the right. */
  @media (max-width: 560px) {
    .chip {
      flex: 1 1 auto;
    }

    .chip-name {
      flex: 1 1 auto;
    }
  }
</style>
