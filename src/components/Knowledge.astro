---
import { getCollection } from 'astro:content';
import { t, href, type Category, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);

const entries = await getCollection('notes');
const counts: Record<Category, number> = { dsa: 0, troubleshooting: 0, patterns: 0 };
for (const entry of entries) counts[entry.data.category] += 1;

/**
 * Longest label in em (measured: "troubleshooting" = 7.28em at weight 300,
 * 4 CJK characters = 4em) as a viewport fraction, so poster words never break.
 */
const fit = lang === 'zh' ? 0.24 : 0.132;
---
<section class="knowledge" id="knowledge" style={`--fit:${fit}`}>
  <div class="wrap">
    <h2 class="visually-hidden">{d.knowledge.heading}</h2>

    <div class="stage">
      <div class="posters">
        {d.knowledge.items.map((item, i) => {
          const n = counts[item.slug];
          return (
            <a
              class="poster"
              href={href(lang, `/notes/${item.slug}/`)}
              data-reveal
              style={`--i:${i}`}
            >
              <span class="label">{item.label}</span>
              <span class="count">{n > 0 ? d.knowledge.count(n) : d.knowledge.empty}</span>
            </a>
          );
        })}
      </div>

      <figure class="figure" data-reveal style="--i:2">
        <img
          src="/img/wac-telephone-switchboard-operators.jpg"
          width="1920"
          height="1476"
          alt={d.knowledge.photoAlt}
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .knowledge {
    background: var(--field-2);
    color: var(--field-2-ink);
  }

  .stage {
    padding-block: 80px;
  }

  .posters {
    display: flex;
    flex-direction: column;
    row-gap: 8px;
  }

  .poster {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    text-decoration: none;
  }

  .label {
    font-size: clamp(64px, 10vw, 150px);
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: lowercase;
    transition: color 180ms var(--ease);
  }

  .count {
    flex: none;
    font-size: clamp(18px, 1.4vw, 20px);
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* Accent pink is too low-contrast on paper, so the hover state uses plum (--field-1). */
  .poster:hover .label,
  .poster:focus-visible .label {
    color: var(--field-1);
  }

  .figure {
    display: none;
    margin: 0;
  }
  .figure img {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  @media (min-width: 1200px) {
    .stage {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 48px;
      align-items: start;
    }
    /* Longest word stays inside the list column; the photo keeps ~300px at the right margin. */
    .label {
      font-size: min(clamp(64px, 10vw, 150px), calc((100vw - 2 * var(--margin) - 22vw - 190px) * var(--fit)));
    }
    .figure {
      display: block;
      inline-size: min(22vw, 360px);
      max-inline-size: 100%;
    }
  }

  @media (max-width: 700px) {
    .poster {
      gap: 12px;
    }
    /* Poster words never break: the longest label (troubleshooting) fits beside a ~100px count. */
    .label {
      font-size: min(15vw, calc((100vw - 2 * var(--margin) - 112px) * var(--fit)));
      line-height: 0.95;
    }
    .count {
      font-size: 16px;
    }
    .posters {
      row-gap: 22px;
    }
  }
</style>
