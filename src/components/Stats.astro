---
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
---

<section id="stats" class="stats">
  <div class="container">
    <div class="banner">
      <div class="claim">
        <h2 class="heading" data-reveal>{d.stats.heading}</h2>
        <figure class="measure" data-reveal style="--i:1">
          <p class="figure">{d.stats.figure}</p>
          <figcaption class="caption">{d.stats.caption}</figcaption>
        </figure>
      </div>

      <figure class="shot" data-reveal style="--i:2">
        <img
          class="drift"
          src="/img/1940s-n935-telephone-exchange.jpg"
          width="1920"
          height="1801"
          alt={d.stats.photoAlt}
          loading="lazy"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .stats {
    background: var(--bg);
    padding-block: clamp(8px, 2vw, 24px);
  }

  .banner {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: stretch;
    background: var(--ink);
    color: #fff;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .claim {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(40px, 6vw, 72px);
    padding: clamp(28px, 4vw, 56px);
  }

  .heading {
    font-size: clamp(26px, 2.4vw, 40px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #fff;
    max-width: 22ch;
  }

  .measure {
    margin: 0;
  }

  .figure {
    font-size: clamp(120px, 14vw, 220px);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.05em;
    font-variant-numeric: lining-nums;
    color: #fff;
    /* Glyph ink extends past the .8 line box; keep it off the heading above. */
    padding-top: 0.15em;
  }

  .caption {
    margin-top: clamp(18px, 2vw, 26px);
    max-width: 34ch;
    font-size: clamp(16px, 1.1vw, 17px);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.72);
  }

  .shot {
    position: relative;
    margin: 0;
    min-height: 100%;
    overflow: hidden;
  }

  .shot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }

  .drift {
    animation: stat-drift 20s ease-in-out infinite alternate;
  }

  @keyframes stat-drift {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drift {
      animation: none;
    }
  }

  @media (max-width: 860px) {
    .banner {
      grid-template-columns: minmax(0, 1fr);
    }

    .claim {
      gap: clamp(32px, 8vw, 56px);
      padding: clamp(24px, 5vw, 40px);
    }

    .heading {
      max-width: none;
    }

    .figure {
      font-size: clamp(120px, 30vw, 220px);
    }

    .shot {
      position: static;
      aspect-ratio: 4 / 3;
    }

    .shot img {
      position: static;
    }
  }
</style>
