---
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
---

<section id="stats" class="stats">
  <div class="wrap grid">
    <div class="claim">
      <h2 class="heading" data-reveal>{d.stats.heading}</h2>
      <figure class="measure" data-reveal style="--i:1">
        <p class="figure">{d.stats.figure}</p>
        <figcaption class="caption" data-reveal style="--i:2">{d.stats.caption}</figcaption>
      </figure>
    </div>

    <figure class="shot" data-reveal style="--i:3">
      <img
        class="drift"
        src="/img/1940s-n935-telephone-exchange.jpg"
        width="1920"
        height="1801"
        alt={d.stats.photoAlt}
        loading="lazy"
      />
    </figure>
  </div>
</section>

<style>
  .stats {
    background: var(--field-1);
    color: var(--ink);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: stretch;
    min-height: 90svh;
  }

  .claim {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(40px, 6vw, 80px);
    padding-block: clamp(48px, 6vw, 96px);
    padding-right: clamp(24px, 3vw, 48px);
  }

  .heading {
    font-size: clamp(36px, 2.6vw, 44px);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .measure {
    margin: 0;
  }

  .figure {
    font-size: clamp(140px, 15vw, 240px);
    font-weight: 300;
    line-height: 0.8;
    letter-spacing: -0.05em;
    font-variant-numeric: lining-nums;
    /* Glyph ink extends past the .8 line box; keep it off the heading above. */
    padding-top: 0.15em;
  }

  .caption {
    margin-top: clamp(18px, 2vw, 26px);
    max-width: 32ch;
    font-size: clamp(16px, 1.1vw, 17px);
    line-height: 1.55;
    color: var(--ink);
  }

  .shot {
    position: relative;
    margin: 0;
    overflow: hidden;
  }

  .shot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }

  .drift {
    animation: stat-drift 20s ease-in-out infinite alternate;
  }

  @keyframes stat-drift {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .drift {
      animation: none;
    }
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    .claim {
      gap: clamp(32px, 8vw, 56px);
      padding-block: clamp(56px, 10vw, 88px);
      padding-right: 0;
    }

    .figure {
      font-size: 34vw;
    }

    .shot {
      position: static;
      aspect-ratio: 4 / 3;
      margin-top: clamp(32px, 7vw, 56px);
      margin-bottom: var(--margin);
    }

    .shot img {
      position: static;
    }
  }
</style>
