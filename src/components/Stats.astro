---
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
---

<section id="stats" class="card" aria-labelledby="stats-label">
  <span class="label" id="stats-label">{d.stats.heading}</span>

  <div class="measure">
    <p class="figure">{d.stats.figure}</p>
    <p class="caption muted">{d.stats.caption}</p>
  </div>

  <figure class="shot">
    <img
      src="/img/1940s-n935-telephone-exchange.jpg"
      width="1920"
      height="1801"
      alt={d.stats.photoAlt}
      loading="lazy"
      decoding="async"
    />
  </figure>
</section>

<style>
  .measure {
    display: flex;
    align-items: baseline;
    gap: clamp(14px, 3vw, 26px);
  }

  .figure {
    flex: 0 0 auto;
    font-size: clamp(64px, 12vw, 96px);
    font-weight: 300;
    line-height: 0.85;
    letter-spacing: -0.05em;
    font-variant-numeric: lining-nums;
  }

  .caption {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 48ch;
    font-size: var(--step-small);
    line-height: 1.5;
  }

  .shot {
    margin: 18px 0 0;
    overflow: hidden;
    border-radius: var(--radius-inner);
    background: var(--surface);
  }

  .shot img {
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    filter: grayscale(1);
  }

  @media (max-width: 480px) {
    .measure {
      display: block;
    }

    .caption {
      margin-top: 10px;
    }
  }
</style>
