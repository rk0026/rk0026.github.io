---
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Pipeline from './Pipeline.astro';
import Stats from './Stats.astro';
import Work from './Work.astro';
import Knowledge from './Knowledge.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import type { Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
---
<Base lang={lang}>
  <Hero lang={lang} />
  <main>
    <About lang={lang} />
    <Pipeline lang={lang} />
    <Stats lang={lang} />
    <Work lang={lang} />
    <Knowledge lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
