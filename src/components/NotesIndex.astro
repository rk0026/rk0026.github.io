---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { t, href, type Lang, type Category } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);

const entries = await getCollection('notes');
const countIn = (slug: Category) => entries.filter((e) => e.id.startsWith(`${slug}/`)).length;
---
<Base
  lang={lang}
  current="notes"
  title={`${d.notes.title} — ${d.footer.rights}`}
  description={d.notes.intro}
>
  <main class="page">
    <section class="card" data-reveal>
      <h1>{d.notes.title}</h1>
      <p class="muted intro">{d.notes.intro}</p>
      <figure class="shot">
        <img
          src="/img/notes.jpg"
          width="1400"
          height="934"
          alt={d.images.notes}
          decoding="async"
        />
      </figure>
    </section>

    <section class="card" aria-label={d.knowledge.heading} data-reveal style="--i:1">
      <span class="label">{d.knowledge.heading}</span>
      <ul class="rows">
        {d.knowledge.items.map((item) => {
          const n = countIn(item.slug);
          return (
            <li>
              <a class="inner row" href={href(lang, `/notes/${item.slug}/`)}>
                <span class="row-main">
                  <span class="row-title">{item.label}</span>
                  <span class="row-desc">{d.notes.descriptions[item.slug]}</span>
                </span>
                <span class="row-side">
                  <span class="count">{n ? d.knowledge.count(n) : d.knowledge.empty}</span>
                  <span class="icon-btn" aria-hidden="true">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
                  </span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  </main>
</Base>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--gap);
  }

  h1 {
    font-size: var(--step-head);
  }

  .intro {
    margin-top: 6px;
    max-width: 60ch;
  }

  .shot {
    margin: 18px 0 0;
  }

  .shot img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--gap);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }

  .row-main {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 2px;
  }

  .row-title {
    font-size: var(--step-lead);
  }

  .row-desc {
    font-size: var(--step-small);
    color: var(--muted);
  }

  .row-side {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .count {
    padding: 4px 8px;
    border-radius: 8px;
    background: var(--surface);
    font-size: var(--step-small);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .row svg {
    width: 16px;
    height: 16px;
  }
</style>
