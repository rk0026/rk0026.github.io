---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { t, href, type Lang, type Category } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);

const entries = await getCollection('notes');
const countIn = (slug: Category) => entries.filter((e) => e.id.startsWith(`${slug}/`)).length;
---
<Base
  lang={lang}
  current="notes"
  title={`${d.notes.title} — ${d.footer.rights}`}
  description={d.notes.intro}
>
  <main class="notes">
    <div class="container page-head">
      <h1 data-reveal>{d.notes.title}</h1>
      <p data-reveal style="--i:1">{d.notes.intro}</p>
    </div>

    <div class="container">
      <figure class="shot" data-reveal style="--i:2">
        <img
          src="/img/marine-field-telephone-switchboard-operator-guadalcanal-circ.jpg"
          width="1920"
          height="1453"
          alt={d.notes.photoAlt}
          decoding="async"
        />
      </figure>

      <section class="cats" aria-labelledby="cats-heading">
        <h2 id="cats-heading" class="visually-hidden">{d.notes.title}</h2>
        {d.knowledge.items.map((item, i) => {
          const n = countIn(item.slug);
          return (
            <a
              class="card cat"
              href={href(lang, `/notes/${item.slug}/`)}
              data-reveal
              style={`--i:${i + 3}`}
            >
              <span class="cat-label">
                {item.label}
                <span class="cat-arrow" aria-hidden="true">↗</span>
              </span>
              <span class="cat-desc">{d.notes.descriptions[item.slug]}</span>
              <span class="cat-count">{n ? d.knowledge.count(n) : d.knowledge.empty}</span>
            </a>
          );
        })}
      </section>
    </div>
  </main>
</Base>

<style>
  .notes {
    padding-bottom: clamp(48px, 8vw, 120px);
  }

  .shot {
    margin: 0;
    padding: 10px;
    border-radius: var(--radius-card);
    background: var(--bg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .shot img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: calc(var(--radius-card) - 10px);
  }

  .cats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
    margin-top: clamp(32px, 5vw, 72px);
  }

  .cat {
    display: flex;
    flex-direction: column;
    gap: 10px;
    text-decoration: none;
    transition: transform 200ms var(--ease), box-shadow 200ms var(--ease);
  }

  .cat:hover,
  .cat:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--shadow-float);
  }

  .cat-label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .cat-arrow {
    font-size: 0.6em;
    color: var(--muted);
    transition: transform 200ms var(--ease), color 200ms var(--ease);
  }

  .cat:hover .cat-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  .cat-desc {
    flex: 1;
    color: var(--muted);
    font-size: clamp(1rem, 0.95rem + 0.15vw, 1.0625rem);
    line-height: 1.5;
  }

  .cat-count {
    align-self: flex-start;
    margin-top: 6px;
    padding: 5px 14px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--muted);
    font-size: var(--step-small);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 860px) {
    .cats {
      grid-template-columns: minmax(0, 1fr);
    }
    .shot img {
      aspect-ratio: 4 / 3;
    }
  }
</style>
