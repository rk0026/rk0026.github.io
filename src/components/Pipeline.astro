---
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);

/* Zigzag serrated bottom edge: 24 teeth across the slip width, 12px deep.
   Percentages keep the teeth even at any slip width; the depth stays 12px. */
const SEGMENTS = 48;
const step = 100 / SEGMENTS;
const zigzag = [
  '0 0',
  '100% 0',
  '100% calc(100% - 12px)',
  ...Array.from({ length: SEGMENTS }, (_, i) => {
    const x = 100 - (i + 1) * step;
    return `${x.toFixed(4)}% ${i % 2 === 0 ? '100%' : 'calc(100% - 12px)'}`;
  }),
].join(', ');

/* Leader filler: repeated middots, clipped by the flex container. No rules, no gradients. */
const leader = '·'.repeat(180);
---

<section id="pipeline" class="card" aria-labelledby="pipeline-label">
  <span class="label" id="pipeline-label">{d.pipeline.heading}</span>
  <p class="intro muted">{d.pipeline.intro}</p>

  <div class="picker" role="group" aria-label={d.pipeline.pickLabel}>
    {d.pipeline.projects.map((p, i) => (
      <button type="button" class="pick" data-target={p.id} aria-pressed={i === 0 ? 'true' : 'false'}>
        {p.name}
      </button>
    ))}
  </div>

  <div class="slips">
    {d.pipeline.projects.map((p, i) => (
      <article class="slip inner" data-slip={p.id} hidden={i !== 0} style={`clip-path: polygon(${zigzag})`}>
        <h2 class="slip-title">{p.name}</h2>
        {p.groups.map((g) => (
          <div class="group">
            <p class="group-name">{g.name}</p>
            <dl class="rows">
              {g.rows.map((r) => (
                <div class="row">
                  <dt class="stage">{r.stage}</dt>
                  <span class="leader" aria-hidden="true">{leader}</span>
                  <dd class="value">{r.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
        <p class="row result">
          <span class="stage">{p.result.stage}</span>
          <span class="leader" aria-hidden="true">{leader}</span>
          <span class="value">{p.result.value}</span>
        </p>
      </article>
    ))}
  </div>
</section>

<script>
  const section = document.getElementById('pipeline');
  if (section) {
    const buttons = Array.from(section.querySelectorAll<HTMLButtonElement>('.pick'));
    const slips = Array.from(section.querySelectorAll<HTMLElement>('[data-slip]'));

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const id = button.dataset.target;
        for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
        for (const slip of slips) {
          const active = slip.dataset.slip === id;
          slip.hidden = !active;
          slip.classList.remove('swap');
          if (active) {
            void slip.offsetWidth;
            slip.classList.add('swap');
          }
        }
      });
    }
  }
</script>

<style>
  .intro {
    max-width: 62ch;
  }

  .picker {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .pick {
    border: 0;
    border-radius: 10px;
    background: var(--surface);
    color: var(--muted);
    font-size: var(--step-small);
    font-weight: 500;
    line-height: 1.2;
    padding: 5px 12px;
    cursor: pointer;
    transition: background-color 160ms var(--ease), color 160ms var(--ease);
  }

  .pick:hover {
    color: var(--ink);
  }

  .pick[aria-pressed='true'] {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .slips {
    margin-top: 14px;
  }

  /* The serrated edge is a clip polygon, so the receipt has square top corners. */
  .slip {
    --slip-pad: 18px;
    padding: var(--slip-pad) var(--slip-pad) 0;
  }

  .slip[hidden] {
    display: none;
  }

  .slip.swap {
    animation: slip-in 320ms var(--ease);
  }

  @keyframes slip-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .slip-title {
    font-size: var(--step-head);
    font-weight: 400;
    line-height: 1.15;
  }

  .group-name {
    margin-top: 22px;
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--muted);
  }

  .rows {
    margin: 4px 0 0;
  }

  .row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 4px;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .stage {
    flex: 0 1 auto;
    min-width: 0;
  }

  dd.value {
    margin: 0;
  }

  .leader {
    flex: 1 1 16px;
    min-width: 8px;
    overflow: hidden;
    white-space: nowrap;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .value {
    flex: 0 0 auto;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    font-weight: 500;
  }

  /* Final row: inverted, and its bottom padding carries the zigzag depth. */
  .result {
    margin: 22px calc(-1 * var(--slip-pad)) 0;
    padding: 14px var(--slip-pad) 30px;
    background: var(--ink);
    color: var(--bg);
    font-weight: 500;
  }

  .result .leader {
    color: inherit;
    opacity: 0.5;
  }

  @media (max-width: 480px) {
    .slip {
      --slip-pad: 14px;
    }
  }
</style>
