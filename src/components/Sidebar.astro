---
import { t, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const icons = ['M3 5h18v14H3z M3 5l9 8 9-8','M7 3H4v5c0 7 5 12 12 12h4v-4l-5-2-2 2a12 12 0 0 1-6-6l2-2z','M5 9v11 M5 5v.1 M10 20V9h5c4 0 4 4 4 6v5','M8 20v-4c-5 0-5-8-2-10V3l4 2h4l4-2v3c3 2 3 10-2 10v4','M12 21s7-7 7-12A7 7 0 0 0 5 9c0 5 7 12 7 12z M12 7v4'];
---
<aside class="card sidebar">
  <div class="identity">
    <img src="/img/me.jpg" width="800" height="1000" alt={d.home.photoAlt} />
    <div><p class="name">{d.home.name}</p><p class="role">{d.home.role}</p></div>
  </div>
  <p class="now muted">{d.home.now}</p>
  <details><summary>{d.contact.heading}</summary>
    <ul>{d.contact.rows.map((row, i) => <li>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d={icons[i]} /></svg>
      <div><span class="muted">{row.label}</span>{row.href ? <a href={row.href}>{row.text}</a> : <p>{row.text}</p>}</div>
    </li>)}</ul>
  </details>
  <a class="btn" href={d.hero.ctaHref} download>{d.home.cv}</a>
</aside>
<style>
.sidebar { position: sticky; top: 32px; padding: 28px 22px; align-self: start; }
.identity { text-align: center; }
.identity img { width: 140px; height: 140px; object-fit: cover; object-position: 50% 25%; border-radius: 20px; margin: 0 auto 20px; }
.name { font-size: 1.65rem; letter-spacing: -.03em; line-height: 1.3; }
.role { display: inline-block; background: var(--surface); border-radius: 8px; padding: 4px 10px; margin-top: 12px; font-size: .8rem; }
.now { font-size: .78rem; text-align: center; margin: 16px 0 24px; }
details { border-top: 1px solid var(--line); padding-top: 22px; margin-bottom: 24px; }
summary { cursor: pointer; font-size: var(--step-small); }
ul { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 22px; }
li { display: flex; gap: 12px; align-items: center; min-width: 0; }
li svg { flex: none; width: 36px; height: 36px; padding: 9px; background: var(--surface); border-radius: 10px; }
li div { min-width: 0; } li span { display: block; font-size: .7rem; margin-bottom: 3px; }
li a, li p { font-size: .8rem; overflow-wrap: anywhere; text-decoration: none; }
.btn { width: 100%; justify-content: center; }
@media(min-width: 1000px) { details:not([open]) > ul { display: grid; } summary { display: none; } }
@media(max-width: 999px) { .sidebar { position: static; padding: 20px; } .identity { display: flex; align-items: center; text-align: left; gap: 20px; } .identity img { width: 80px; height: 80px; margin: 0; } .now { text-align: left; margin: 16px 0; } .name { font-size: 1.5rem; } .btn { width: auto; } }
</style>
<script>
  const details = document.querySelector<HTMLDetailsElement>('.sidebar details');
  const desktop = matchMedia('(min-width: 1000px)');
  const sync = () => { if (details) details.open = desktop.matches; };
  sync();
  desktop.addEventListener('change', sync);
</script>
