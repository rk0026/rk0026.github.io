---
import { t, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const mailto = `mailto:abc751202@gmail.com?subject=${encodeURIComponent(d.contact.mailSubject)}`;
---
<section class="contact" id="contact">
  <h2 class="visually-hidden">{d.contact.heading}</h2>

  <ul class="rows">
    {d.contact.rows.map((row, i) => (
      <li class:list={['row', i % 2 === 1 && 'row--alt']}>
        <div class="wrap row-inner" data-reveal>
          {row.href
            ? <a href={row.href} rel={row.href.startsWith('http') ? 'noopener' : undefined}>{row.text}</a>
            : <span>{row.text}</span>}
        </div>
      </li>
    ))}
    <li class:list={['row', d.contact.rows.length % 2 === 1 && 'row--alt']}>
      <div class="wrap row-inner greet" data-reveal>
        <span>{d.contact.greeting}</span>
        <a class="round" href={mailto} aria-label={d.contact.greeting}>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </li>
  </ul>
</section>

<style>
  .contact {
    padding-top: calc(var(--section-gap) * 0.5);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    background: var(--bg);
  }

  .row--alt {
    background: var(--surface);
  }

  .row-inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    min-height: 150px;
    padding-bottom: clamp(24px, 3.4vw, 44px);
    font-size: clamp(44px, 6vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  .row-inner a,
  .row-inner span {
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .row-inner a {
    transition: color 160ms var(--ease);
  }

  .row-inner a:hover {
    color: var(--accent);
  }

  .greet {
    align-items: center;
  }

  .round {
    display: grid;
    place-items: center;
    flex: none;
    width: clamp(64px, 8vw, 104px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: clamp(24px, 2.6vw, 34px);
    transition: transform 160ms var(--ease);
  }

  .round:hover {
    transform: translateY(-2px);
  }

  .round:active {
    transform: scale(0.96);
  }

  @media (max-width: 700px) {
    .row-inner {
      min-height: 84px;
      gap: 16px;
      padding-bottom: 20px;
      font-size: 7vw;
      letter-spacing: -0.01em;
    }

    .round {
      width: 56px;
      font-size: 22px;
    }
  }
</style>
