---
import credits from '../data/credits.json';
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const year = new Date().getFullYear();
const links = d.contact.rows.filter((row) => row.href && /^(mailto:|https?:)/.test(row.href));
---
<footer class="footer">
  <h2 class="visually-hidden">{d.footer.rights}</h2>

  <div class="footer-word" aria-hidden="true">{d.hero.word}</div>

  <nav class="links" aria-label={d.contact.heading}>
    {links.map((row) => <a href={row.href}>{row.text}</a>)}
  </nav>

  <div class="wrap">
    <p class="credits">
      <span class="credits-label">{d.footer.creditsLabel}</span>
      {credits.map((c, i) => (
        <span class="credit">
          “<a href={c.page}>{c.title}</a>” by {c.creator},{' '}
          <a href={c.licenseUrl}>{c.license}</a>, via {c.via}{i < credits.length - 1 ? '; ' : ''}
        </span>
      ))}
    </p>
    <p class="rights">© {year} {d.footer.rights}</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: calc(var(--section-gap) * 0.5) var(--margin);
    overflow: clip;
    text-align: center;
  }

  .footer-word {
    font-size: 6vw;
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.04em;
    white-space: nowrap;
    margin-bottom: clamp(24px, 3vw, 40px);
    animation: word-in 700ms var(--ease) both;
  }

  @keyframes word-in {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .links a {
    padding: 9px 20px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--step-small);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 160ms var(--ease), color 160ms var(--ease);
  }

  .links a:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .credits {
    max-width: 78ch;
    margin-inline: auto;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .credits-label {
    display: block;
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.6875rem;
  }

  .credit a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .credit a:hover {
    color: var(--ink);
  }

  .rights {
    margin-top: 16px;
    font-size: 0.75rem;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .footer {
      padding-bottom: calc(96px + env(safe-area-inset-bottom, 0px));
    }
    .footer-word {
      font-size: 12vw;
    }
  }
</style>
