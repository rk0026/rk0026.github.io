---
import credits from '../data/credits.json';
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const year = new Date().getFullYear();
---
<footer class="card" data-reveal>
  <ul class="rows" aria-label={d.contact.heading}>
    {d.contact.rows.map((row) => {
      const external = !!row.href && /^https?:/.test(row.href);
      return (
        <li>
          {row.href ? (
            <a
              class="inner row"
              href={row.href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener' : undefined}
            >
              <span class="row-label">{row.label}</span>
              <span class="row-value">{row.text}</span>
              <span class="icon-btn" aria-hidden="true">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
            </a>
          ) : (
            <div class="inner row">
              <span class="row-label">{row.label}</span>
              <span class="row-value">{row.text}</span>
            </div>
          )}
        </li>
      );
    })}
  </ul>

  <p class="credits">
    <span class="credits-label">{d.footer.creditsLabel}</span>
    {credits.map((c, i) => (
      <span>
        “<a href={c.page}>{c.title}</a>” by {c.creator},{' '}
        <a href={c.licenseUrl}>{c.license}</a>, via {c.via}
        {i < credits.length - 1 ? '; ' : ''}
      </span>
    ))}
  </p>

  <p class="rights">{year} © {d.footer.rights}</p>
</footer>

<style>
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--gap);
  }

  .row {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .row-label {
    flex: none;
    font-size: var(--step-small);
    color: var(--muted);
  }

  .row-value {
    margin-left: auto;
    min-width: 0;
    text-align: right;
    font-size: var(--step-lead);
    overflow-wrap: anywhere;
  }

  .row .icon-btn {
    flex: none;
  }

  .row svg {
    width: 16px;
    height: 16px;
  }

  .credits {
    margin-top: 18px;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .credits-label {
    display: block;
    margin-bottom: 4px;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .credits a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .credits a:hover {
    color: var(--ink);
  }

  .rights {
    margin-top: 18px;
    text-align: center;
    font-size: var(--step-small);
    color: var(--muted);
  }
</style>
