---
import credits from '../data/credits.json';
import { t, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const year = new Date().getFullYear();
const links = d.contact.rows.filter((row) => row.href && /^(mailto:|https?:)/.test(row.href));
// 24×24 single-path icons (mail outline; LinkedIn and GitHub marks), drawn in currentColor.
const icon = (href: string) =>
  href.startsWith('mailto:')
    ? 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2.4V17h16V7.4l-8 5.6-8-5.6ZM5.6 7 12 11.5 18.4 7H5.6Z'
    : href.includes('linkedin')
      ? 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4V21H3V9.75Zm6.5 0h3.8v1.6h.06c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.77 2.65 4.77 6.1V21h-4v-5c0-1.2-.02-2.73-1.66-2.73-1.67 0-1.92 1.3-1.92 2.64V21h-4V9.75Z'
      : 'M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z';
---
<footer class="footer">
  <h2 class="visually-hidden">{d.footer.rights}</h2>

  <div class="footer-word" aria-hidden="true">{d.hero.word}</div>

  <nav class="links" aria-label={d.contact.heading}>
    {links.map((row) => (
      <a href={row.href}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={icon(row.href!)} /></svg>
        {row.text}
      </a>
    ))}
  </nav>

  <div class="wrap">
    <p class="credits">
      <span class="credits-label">{d.footer.creditsLabel}</span>
      {credits.map((c, i) => (
        <span class="credit">
          “<a href={c.page}>{c.title}</a>” by {c.creator},{' '}
          <a href={c.licenseUrl}>{c.license}</a>, via {c.via}{i < credits.length - 1 ? '; ' : ''}
        </span>
      ))}
    </p>
    <p class="rights">© {year} {d.footer.rights}</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: calc(var(--section-gap) * 0.5) var(--margin);
    overflow: clip;
    text-align: center;
  }

  .footer-word {
    font-size: clamp(2rem, 3.5vw, 3.5rem);
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.04em;
    white-space: nowrap;
    margin-bottom: clamp(24px, 3vw, 40px);
    animation: word-in 700ms var(--ease) both;
  }

  @keyframes word-in {
    from {
      opacity: 0;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 20px 9px 16px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--step-small);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 160ms var(--ease), color 160ms var(--ease);
  }

  .links a:hover {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .credits {
    max-width: 78ch;
    margin-inline: auto;
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .credits-label {
    display: block;
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.6875rem;
  }

  .credit a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .credit a:hover {
    color: var(--ink);
  }

  .rights {
    margin-top: 16px;
    font-size: 0.75rem;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .footer {
      padding-bottom: calc(96px + env(safe-area-inset-bottom, 0px));
    }
    .footer-word {
      font-size: 9vw;
    }
  }
</style>
