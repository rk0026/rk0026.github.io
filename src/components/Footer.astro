---
import { t, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
---
<footer>
  <p class="rights">{new Date().getFullYear()} © {d.footer.rights}</p>
</footer>
<style>footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line); font-size: .7rem; color: var(--muted); } .rights { text-align: center; }</style>
