---
import { t, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
---
<section class="about wrap" id="about">
  <h2 class="visually-hidden">{d.about.heading}</h2>

  <p class="story" data-reveal>
    {d.about.parts.map((part) =>
      typeof part === 'string' ? part : <mark class={`hl hl--${part.tone}`}>{part.text}</mark>
    )}{lang === 'en' ? ' ' : null}<a class="closing" href="#contact">{d.about.closing}</a>
  </p>

  <img
    class="band"
    src="/img/marine-field-telephone-switchboard-operator-guadalcanal-circ.jpg"
    width="1920"
    height="1453"
    alt={d.notes.photoAlt}
    loading="lazy"
    data-reveal
  />
</section>

<style>
  .about {
    padding-block: calc(var(--section-gap) * 0.6) calc(var(--section-gap) * 0.5);
  }

  .story {
    columns: 2;
    column-gap: 32px;
    text-align: justify;
    hyphens: auto;
    font-size: clamp(22px, 2.1vw, 32px);
    line-height: 1.18;
    color: var(--ink);
    text-wrap: pretty;
  }

  .hl,
  .closing {
    padding-inline: 0.1em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    color: var(--accent-ink);
    background-color: var(--accent);
  }

  .hl--plum {
    background-color: var(--field-1);
    color: var(--field-1-ink);
  }

  .hl--paper {
    background-color: var(--field-2);
    color: var(--field-2-ink);
  }

  .closing {
    text-decoration: none;
    transition: background-color 160ms var(--ease);
  }

  .closing:hover {
    background-color: var(--field-2);
    color: var(--field-2-ink);
  }

  .band {
    width: calc(100% + 2 * var(--margin));
    max-width: none;
    margin: calc(var(--section-gap) * 0.5) calc(var(--margin) * -1) 0;
    aspect-ratio: 16 / 6;
    object-fit: cover;
    object-position: 50% 35%;
    filter: grayscale(1);
  }

  @media (max-width: 700px) {
    .story {
      columns: 1;
      font-size: 20px;
      line-height: 1.22;
      text-align: left;
      hyphens: none;
    }

    .band {
      aspect-ratio: 4 / 3;
    }
  }
</style>
