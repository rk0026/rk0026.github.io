---
import { t, href, type Lang } from '../i18n';

const { lang } = Astro.props as { lang: Lang };
const d = t(lang);

/* Same path in the other locale: strip a leading /en, add it back for zh. */
const bare = Astro.url.pathname.replace(/\/+$/, '').replace(/^\/en(?=\/|$)/, '');
const switchPath = lang === 'zh' ? `/en${bare}/` : `${bare}/`;
const switchLang = lang === 'zh' ? 'en' : 'zh-Hant-TW';
---
<header class="bar wrap">
  <a class="mark" href={href(lang, '/')}>{d.hero.word}</a>
  <nav class="links" aria-label={d.nav.notes}>
    <a href={href(lang, '/notes/')} aria-current="page">{d.nav.notes}</a>
    <a href={switchPath} lang={switchLang} hreflang={switchLang}>{d.nav.switchLabel}</a>
  </nav>
</header>

<style>
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-block: clamp(16px, 2.4vw, 28px);
  }
  .mark {
    font-size: 1rem;
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .links {
    display: flex;
    gap: clamp(16px, 2.4vw, 32px);
    font-size: var(--step-small);
  }
  .links a {
    color: var(--muted);
    text-decoration: none;
    transition: color 180ms var(--ease);
  }
  .links a:hover,
  .links a[aria-current] {
    color: var(--ink);
  }
</style>
