---
// Interactive 3D "modular system core". Pure enhancement: the module buttons and
// detail panels in Landing.astro work without WebGL; the scene only mirrors them.
interface Props { labels: string[] }
const { labels } = Astro.props;
---
<div class="core" data-labels={JSON.stringify(labels)}>
  <canvas aria-hidden="true"></canvas>
</div>

<script>
  const host = document.querySelector<HTMLElement>('.core');
  const canvas = host?.querySelector('canvas');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const gl = canvas && (canvas.getContext('webgl2') || canvas.getContext('webgl'));
  if (host && canvas && gl) init(host, canvas).catch(() => host.classList.add('off'));
  else host?.classList.add('off');

  async function init(host: HTMLElement, canvas: HTMLCanvasElement) {
    const THREE = await import('three');
    const { RoundedBoxGeometry } = await import('three/addons/geometries/RoundedBoxGeometry.js');
    const labels: string[] = JSON.parse(host.dataset.labels || '[]');
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-module]')];

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(28, 1, 0.1, 100);
    camera.position.set(6.6, 7.2, 8.2);
    camera.lookAt(0, 0.2, 0);

    scene.add(new THREE.HemisphereLight(0xffffff, 0x888888, 1.6));
    const sun = new THREE.DirectionalLight(0xffffff, 2.2);
    sun.position.set(5, 10, 4);
    sun.castShadow = true;
    sun.shadow.mapSize.set(1024, 1024);
    Object.assign(sun.shadow.camera, { left: -5, right: 5, top: 5, bottom: -5 });
    sun.shadow.radius = 6;
    scene.add(sun);

    const rig = new THREE.Group();
    scene.add(rig);

    const mat = (c = 0xffffff) => new THREE.MeshStandardMaterial({ color: c, roughness: 0.55, metalness: 0.05 });
    const base = new THREE.Mesh(new THREE.CylinderGeometry(3.2, 3.35, 0.36, 72), mat());
    base.position.y = -0.18;
    base.receiveShadow = true;
    rig.add(base);

    const core = new THREE.Mesh(new RoundedBoxGeometry(1.5, 1.1, 1.5, 4, 0.16), mat());
    core.position.y = 0.55;
    core.castShadow = true;
    rig.add(core);

    // Five modules on a ring around the core, each with a channel back to it.
    const R = 2.15;
    const modules = labels.map((label, i) => {
      const a = -Math.PI / 2 + (i * Math.PI * 2) / labels.length;
      const x = Math.cos(a) * R, z = Math.sin(a) * R;
      const group = new THREE.Group();
      group.position.set(x, 0, z);
      const body = new THREE.Mesh(new RoundedBoxGeometry(1.15, 0.5, 1.15, 4, 0.12), mat());
      body.position.y = 0.25;
      body.castShadow = true;
      body.userData.index = i;
      const face = new THREE.Mesh(new THREE.PlaneGeometry(1.0, 1.0), new THREE.MeshBasicMaterial({ transparent: true }));
      // Lay flat, then spin in-plane so text reads upright from the camera's azimuth.
      face.rotation.set(-Math.PI / 2, 0, Math.atan2(camera.position.x, camera.position.z));
      face.position.y = 0.505;
      face.userData.index = i;
      group.add(body, face);
      rig.add(group);

      const channel = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.04, R - 1.35), mat());
      channel.position.set(x / 2, 0.02, z / 2);
      channel.lookAt(new THREE.Vector3(x, 0.02, z));
      rig.add(channel);

      const pulse = new THREE.Mesh(new THREE.SphereGeometry(0.06, 12, 12), new THREE.MeshBasicMaterial());
      pulse.position.y = 0.08;
      rig.add(pulse);
      return { label, group, body, face, x, z, pulse, lift: 0, phase: i / labels.length };
    });
    const pickable = modules.flatMap((m) => [m.body, m.face]);

    let theme = { card: '', ink: '', surface: '', line: '', muted: '', ok: '', bg: '', accent: '', accentInk: '' };
    const readTheme = () => {
      const s = getComputedStyle(document.documentElement);
      const v = (n: string) => s.getPropertyValue(n).trim();
      theme = { card: v('--card'), ink: v('--ink'), surface: v('--surface'), line: v('--line'), muted: v('--muted'), ok: v('--ok'), bg: v('--bg'), accent: v('--accent'), accentInk: v('--accent-ink') };
    };
    const labelTexture = (text: string, fg: string) => {
      const c = document.createElement('canvas');
      c.width = c.height = 256;
      const x = c.getContext('2d')!;
      x.fillStyle = fg;
      x.textAlign = 'center';
      x.textBaseline = 'middle';
      x.font = `500 ${text.length > 8 ? 34 : 42}px Geist, "Noto Sans TC", sans-serif`;
      x.fillText(text, 128, 128);
      const t = new THREE.CanvasTexture(c);
      t.colorSpace = THREE.SRGBColorSpace;
      t.anisotropy = 4;
      return t;
    };

    let selected = 0;
    let hovered = -1;
    const paint = () => {
      readTheme();
      (base.material as THREE.MeshStandardMaterial).color.set(theme.surface);
      (core.material as THREE.MeshStandardMaterial).color.set(theme.ink);
      modules.forEach((m, i) => {
        const on = i === selected;
        (m.body.material as THREE.MeshStandardMaterial).color.set(on ? theme.accent : theme.card);
        const fm = m.face.material as THREE.MeshBasicMaterial;
        fm.map?.dispose();
        fm.map = labelTexture(m.label, on ? theme.accentInk : theme.ink);
        fm.needsUpdate = true;
        (m.pulse.material as THREE.MeshBasicMaterial).color.set(theme.ok);
      });
      rig.children.filter((o) => o instanceof THREE.Mesh && (o.geometry as THREE.BufferGeometry).type === 'BoxGeometry')
        .forEach((o) => ((o as THREE.Mesh).material as THREE.MeshStandardMaterial).color.set(theme.line));
      wake();
    };

    const select = (i: number) => {
      selected = i;
      buttons.forEach((b, j) => b.setAttribute('aria-pressed', String(j === i)));
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p, j) => (p.hidden = j !== i));
      paint();
    };
    buttons.forEach((b, i) => b.addEventListener('click', () => select(i)));

    const ray = new THREE.Raycaster();
    const ndc = new THREE.Vector2();
    let tiltX = 0, tiltY = 0;
    const pick = (e: PointerEvent) => {
      const r = canvas.getBoundingClientRect();
      ndc.set(((e.clientX - r.left) / r.width) * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1);
      ray.setFromCamera(ndc, camera);
      const hit = ray.intersectObjects(pickable)[0];
      return hit ? (hit.object.userData.index as number) : -1;
    };
    canvas.addEventListener('pointermove', (e) => {
      hovered = pick(e);
      canvas.style.cursor = hovered >= 0 ? 'pointer' : '';
      tiltY = ndc.x * 0.12;
      tiltX = -ndc.y * 0.05;
      wake();
    });
    canvas.addEventListener('pointerleave', () => { hovered = -1; tiltX = tiltY = 0; wake(); });
    canvas.addEventListener('click', (e) => { const i = pick(e as PointerEvent); if (i >= 0) select(i); });

    const resize = () => {
      const { width, height } = host.getBoundingClientRect();
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      wake();
    };
    new ResizeObserver(resize).observe(host);
    new MutationObserver(paint).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    // Render loop runs only while visible; reduced motion renders on demand.
    let visible = true, raf = 0, last = performance.now();
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; wake(); }).observe(host);
    document.addEventListener('visibilitychange', wake);
    function wake() { if (!raf) raf = requestAnimationFrame(frame); }
    function frame(now: number) {
      raf = 0;
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      const k = reduce ? 1 : 1 - Math.pow(0.0005, dt);
      let moving = false;
      modules.forEach((m, i) => {
        const target = i === selected ? 0.32 : i === hovered ? 0.16 : 0;
        m.lift += (target - m.lift) * k;
        if (Math.abs(target - m.lift) > 0.001) moving = true;
        m.group.position.y = m.lift;
        m.phase = reduce ? 0.5 : (m.phase + dt * 0.35) % 1;
        const t = 0.78 + m.phase * (R - 0.6 - 0.78) / R;
        m.pulse.position.set(m.x * t, 0.08, m.z * t);
        m.pulse.visible = !reduce;
      });
      if (!reduce) {
        rig.rotation.y += (tiltY + Math.sin(now / 6000) * 0.08 - rig.rotation.y) * k;
        rig.rotation.x += (tiltX - rig.rotation.x) * k;
      }
      renderer.render(scene, camera);
      if (visible && !document.hidden && (!reduce || moving)) wake();
    }

    paint();
    resize();
    host.classList.add('on');
  }
</script>

<style>
  .core { position: relative; width: 100%; aspect-ratio: 5 / 4; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity 600ms var(--ease); touch-action: manipulation; }
  .core:global(.on) canvas { opacity: 1; }
  .core:global(.off) { display: none; }
</style>
