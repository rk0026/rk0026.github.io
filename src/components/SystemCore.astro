---
// Interactive 3D system core: five mini server racks around a core switch.
// Pure enhancement: the module buttons and detail panels in Landing.astro work
// without WebGL; the scene only mirrors the selection.
interface Props { modules: Array<{ id: string; label: string }> }
const { modules } = Astro.props;
---
<div class="core" data-modules={JSON.stringify(modules)}>
  <canvas aria-hidden="true"></canvas>
</div>

<script>
  // Discipline colours, shared with the tags on the Projects page.
  const COLORS: Record<string, string> = {
    interface: '#ff4f00',
    services: '#4d8dff',
    data: '#c6e85a',
    delivery: '#ffc23d',
    operations: '#a98bff',
  };

  const host = document.querySelector<HTMLElement>('.core');
  const canvas = host?.querySelector('canvas');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const gl = canvas && (canvas.getContext('webgl2') || canvas.getContext('webgl'));
  if (host && canvas && gl) init(host, canvas).catch(() => host.classList.add('off'));
  else host?.classList.add('off');

  async function init(host: HTMLElement, canvas: HTMLCanvasElement) {
    const THREE = await import('three');
    const { RoundedBoxGeometry } = await import('three/addons/geometries/RoundedBoxGeometry.js');
    const defs: Array<{ id: string; label: string }> = JSON.parse(host.dataset.modules || '[]');
    const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-module]')];

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    // Render at least 1.5x so edges and labels stay crisp on 1x screens.
    renderer.setPixelRatio(Math.min(Math.max(devicePixelRatio, 1.5), 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(28, 1, 0.1, 100);
    camera.position.set(6.6, 7.2, 8.2);
    camera.lookAt(0, 0.45, 0);
    const facing = Math.atan2(camera.position.x, camera.position.z);

    scene.add(new THREE.HemisphereLight(0xffffff, 0x8899bb, 1.6));
    const sun = new THREE.DirectionalLight(0xffffff, 2.2);
    sun.position.set(5, 10, 4);
    sun.castShadow = true;
    sun.shadow.mapSize.set(2048, 2048);
    Object.assign(sun.shadow.camera, { left: -5, right: 5, top: 5, bottom: -5 });
    sun.shadow.radius = 6;
    scene.add(sun);

    const rig = new THREE.Group();
    scene.add(rig);

    const lit = () => new THREE.MeshStandardMaterial({ roughness: 0.5, metalness: 0.08 });
    const glow = () => new THREE.MeshBasicMaterial();
    const leds: Array<{ mesh: THREE.Mesh; rack: number; phase: number; speed: number }> = [];

    const base = new THREE.Mesh(new THREE.CylinderGeometry(3.2, 3.35, 0.36, 72), lit());
    base.position.y = -0.18;
    base.receiveShadow = true;
    rig.add(base);

    // Core switch: a squat chassis with a grid of port lights on top.
    const core = new THREE.Group();
    const coreBody = new THREE.Mesh(new RoundedBoxGeometry(1.5, 0.55, 1.5, 4, 0.1), lit());
    coreBody.position.y = 0.275;
    coreBody.castShadow = true;
    core.add(coreBody);
    for (let r = 0; r < 4; r++) for (let c = 0; c < 6; c++) {
      const port = new THREE.Mesh(new THREE.BoxGeometry(0.12, 0.03, 0.1), glow());
      port.position.set(-0.5 + c * 0.2, 0.565, -0.42 + r * 0.28);
      core.add(port);
      leds.push({ mesh: port, rack: -1, phase: Math.random() * 10, speed: 1 + Math.random() * 2 });
    }
    rig.add(core);

    // Rack geometry, shared by all five.
    const W = 0.86, H = 1.3, D = 0.74, UNITS = 5;
    const bodyGeo = new RoundedBoxGeometry(W, H, D, 4, 0.06);
    const unitGeo = new THREE.BoxGeometry(W - 0.14, 0.17, 0.05);
    const ledGeo = new THREE.BoxGeometry(0.05, 0.035, 0.012);
    const stripeGeo = new THREE.BoxGeometry(0.035, H - 0.2, 0.02);
    const channelMat = lit();
    // Rear: vent slats, a power strip with two lights, and three cables dropping to the base.
    const slatGeo = new THREE.BoxGeometry(W - 0.26, 0.03, 0.02);
    const pduGeo = new THREE.BoxGeometry(0.07, H - 0.3, 0.035);
    const rearMat = lit();
    const pduMat = lit();
    const cableGeos = [-0.22, -0.08, 0.06].map((cx, k) => new THREE.TubeGeometry(new THREE.CatmullRomCurve3([
      new THREE.Vector3(cx, 0.55 + k * 0.12, -D / 2 - 0.01),
      new THREE.Vector3(cx, 0.4 + k * 0.08, -D / 2 - 0.16),
      new THREE.Vector3(cx * 0.6, 0.12, -D / 2 - 0.32),
      new THREE.Vector3(cx * 0.3, 0.03, -D / 2 - 0.5),
    ]), 24, 0.022, 8));

    const R = 2.2;
    const racks = defs.map((def, i) => {
      const a = -Math.PI / 2 + (i * Math.PI * 2) / defs.length;
      const x = Math.cos(a) * R, z = Math.sin(a) * R;
      const group = new THREE.Group();
      group.position.set(x, 0, z);
      group.rotation.y = facing; // every front faces the viewer
      group.userData.index = i;

      const body = new THREE.Mesh(bodyGeo, lit());
      body.position.y = H / 2;
      body.castShadow = true;
      group.add(body);

      const units = Array.from({ length: UNITS }, (_, u) => {
        const unit = new THREE.Mesh(unitGeo, lit());
        unit.position.set(0, 0.2 + u * 0.22, D / 2 + 0.02);
        group.add(unit);
        for (let k = 0; k < 2; k++) {
          const led = new THREE.Mesh(ledGeo, glow());
          led.position.set(W / 2 - 0.16 - k * 0.08, unit.position.y, D / 2 + 0.05);
          group.add(led);
          leds.push({ mesh: led, rack: i, phase: Math.random() * 10, speed: 0.6 + Math.random() * 2.4 });
        }
        return unit;
      });

      const stripe = new THREE.Mesh(stripeGeo, glow());
      stripe.position.set(-W / 2 + 0.07, H / 2, D / 2 + 0.03);
      group.add(stripe);

      for (let s = 0; s < 9; s++) {
        const slat = new THREE.Mesh(slatGeo, rearMat);
        slat.position.set(-0.06, 0.62 + s * 0.065, -D / 2 - 0.01);
        group.add(slat);
      }
      const pdu = new THREE.Mesh(pduGeo, pduMat);
      pdu.position.set(W / 2 - 0.1, H / 2, -D / 2 - 0.02);
      group.add(pdu);
      for (let k = 0; k < 2; k++) {
        const led = new THREE.Mesh(ledGeo, glow());
        led.position.set(W / 2 - 0.1, H - 0.28 - k * 0.07, -D / 2 - 0.04);
        group.add(led);
        leds.push({ mesh: led, rack: i, phase: Math.random() * 10, speed: 0.4 + Math.random() });
      }
      const cableMat = lit();
      cableGeos.forEach((g) => group.add(new THREE.Mesh(g, cableMat)));

      // Name tag floats above the rack and always faces the camera, from any angle.
      const tag = new THREE.Sprite(new THREE.SpriteMaterial({ transparent: true }));
      tag.position.y = H + 0.36;
      tag.scale.set(1.5, 0.375, 1);
      group.add(tag);
      rig.add(group);

      const channel = new THREE.Mesh(new THREE.BoxGeometry(0.08, 0.04, R - 1.25), channelMat);
      channel.position.set(x / 2, 0.02, z / 2);
      channel.lookAt(new THREE.Vector3(x, 0.02, z));
      rig.add(channel);

      const pulse = new THREE.Mesh(new THREE.SphereGeometry(0.06, 12, 12), glow());
      pulse.position.y = 0.08;
      rig.add(pulse);
      return { def, color: COLORS[def.id] ?? '#2f6bff', group, body, units, stripe, tag, cableMat, x, z, pulse, lift: 0, phase: i / defs.length };
    });

    let theme: Record<string, string> = {};
    const readTheme = () => {
      const s = getComputedStyle(document.documentElement);
      const v = (n: string) => s.getPropertyValue(n).trim();
      theme = { card: v('--card'), ink: v('--ink'), surface: v('--surface'), line: v('--line'), ok: v('--ok') };
    };
    const labelTexture = (text: string, fg: string, bg: string, border: string) => {
      const c = document.createElement('canvas');
      c.width = 1024;
      c.height = 256;
      const x = c.getContext('2d')!;
      x.font = `600 120px Geist, "Noto Sans TC", sans-serif`;
      const w = Math.min(x.measureText(text).width + 120, 1016);
      x.beginPath();
      x.roundRect((1024 - w) / 2, 28, w, 200, 100);
      x.fillStyle = bg;
      x.fill();
      x.lineWidth = 6;
      x.strokeStyle = border;
      x.stroke();
      x.fillStyle = fg;
      x.textAlign = 'center';
      x.textBaseline = 'middle';
      x.fillText(text, 512, 132);
      const t = new THREE.CanvasTexture(c);
      t.colorSpace = THREE.SRGBColorSpace;
      t.anisotropy = renderer.capabilities.getMaxAnisotropy();
      return t;
    };

    let selected = 0;
    let hovered = -1;
    const set = (m: THREE.Mesh, c: string) => ((m.material as THREE.MeshStandardMaterial).color.set(c));
    const paint = () => {
      readTheme();
      set(base, theme.surface);
      set(coreBody, theme.ink);
      channelMat.color.set(theme.line);
      rearMat.color.set(theme.line);
      pduMat.color.set(theme.ink);
      racks.forEach((r, i) => {
        const on = i === selected;
        set(r.body, on ? r.color : theme.card);
        r.units.forEach((u) => set(u, on ? theme.card : theme.line));
        set(r.stripe, r.color);
        const tm = r.tag.material as THREE.SpriteMaterial;
        tm.map?.dispose();
        tm.map = on ? labelTexture(r.def.label, '#0b1a33', r.color, r.color) : labelTexture(r.def.label, theme.ink, theme.card, theme.line);
        tm.needsUpdate = true;
        set(r.pulse, r.color);
        r.cableMat.color.set(r.color);
      });
      wake();
    };

    const select = (i: number) => {
      selected = i;
      buttons.forEach((b, j) => b.setAttribute('aria-pressed', String(j === i)));
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p, j) => (p.hidden = j !== i));
      paint();
    };
    buttons.forEach((b, i) => b.addEventListener('click', () => select(i)));

    const ray = new THREE.Raycaster();
    const ndc = new THREE.Vector2();
    // Drag (mouse or touch) spins the whole core 360°; a press without movement selects a rack.
    let rotY = 0, rotX = 0, vel = 0, dragging = false, moved = 0, lastX = 0, lastY = 0;
    const pick = (e: PointerEvent) => {
      const b = canvas.getBoundingClientRect();
      ndc.set(((e.clientX - b.left) / b.width) * 2 - 1, -((e.clientY - b.top) / b.height) * 2 + 1);
      ray.setFromCamera(ndc, camera);
      let o: THREE.Object3D | null = ray.intersectObjects(racks.map((r) => r.group), true)[0]?.object ?? null;
      while (o && o.userData.index === undefined) o = o.parent;
      return o ? (o.userData.index as number) : -1;
    };
    canvas.addEventListener('pointerdown', (e) => {
      dragging = true;
      moved = 0;
      vel = 0;
      lastX = e.clientX;
      lastY = e.clientY;
      canvas.setPointerCapture(e.pointerId);
      canvas.style.cursor = 'grabbing';
    });
    canvas.addEventListener('pointermove', (e) => {
      if (dragging) {
        const dx = e.clientX - lastX, dy = e.clientY - lastY;
        lastX = e.clientX;
        lastY = e.clientY;
        moved += Math.abs(dx) + Math.abs(dy);
        vel = dx * 0.01;
        rotY += vel;
        rotX = Math.min(0.35, Math.max(-0.2, rotX + dy * 0.004));
      } else {
        hovered = pick(e);
        canvas.style.cursor = hovered >= 0 ? 'pointer' : 'grab';
      }
      wake();
    });
    const release = (e: PointerEvent, click: boolean) => {
      if (!dragging) return;
      dragging = false;
      canvas.style.cursor = 'grab';
      if (click && moved < 6) { const i = pick(e); if (i >= 0) select(i); }
      if (reduce) vel = 0;
      wake();
    };
    canvas.addEventListener('pointerup', (e) => release(e, true));
    canvas.addEventListener('pointercancel', (e) => release(e, false));
    canvas.addEventListener('pointerleave', () => { if (!dragging) { hovered = -1; wake(); } });

    const resize = () => {
      const { width, height } = host.getBoundingClientRect();
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();
      wake();
    };
    new ResizeObserver(resize).observe(host);
    new MutationObserver(paint).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    // Render loop runs only while visible; reduced motion renders on demand.
    let visible = true, raf = 0, last = performance.now();
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; wake(); }).observe(host);
    document.addEventListener('visibilitychange', wake);
    function wake() { if (!raf) raf = requestAnimationFrame(frame); }
    function frame(now: number) {
      raf = 0;
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      const k = reduce ? 1 : 1 - Math.pow(0.0005, dt);
      let moving = false;
      racks.forEach((r, i) => {
        const target = i === selected ? 0.3 : i === hovered ? 0.14 : 0;
        r.lift += (target - r.lift) * k;
        if (Math.abs(target - r.lift) > 0.001) moving = true;
        r.group.position.y = r.lift;
        r.phase = reduce ? 0.5 : (r.phase + dt * 0.35) % 1;
        const t = 0.78 + r.phase * (R - 0.55 - 0.78) / R;
        r.pulse.position.set(r.x * t, 0.08, r.z * t);
        r.pulse.visible = !reduce;
      });
      // Status lights: steady on the selected rack, blinking elsewhere.
      leds.forEach((l) => {
        const steady = reduce || l.rack === selected;
        const on = steady || Math.sin(now / 1000 * l.speed + l.phase) > -0.2;
        (l.mesh.material as THREE.MeshBasicMaterial).color.set(on ? theme.ok : theme.line);
      });
      if (!dragging && Math.abs(vel) > 0.0005) {
        rotY += vel;
        vel *= Math.pow(0.04, dt); // inertia after a flick
        moving = true;
      }
      rig.rotation.y = rotY;
      rig.rotation.x = rotX;
      renderer.render(scene, camera);
      if (visible && !document.hidden && (!reduce || moving || dragging)) wake();
    }

    paint();
    resize();
    host.classList.add('on');
  }
</script>

<style>
  .core { position: relative; width: 100%; aspect-ratio: 5 / 4; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity 600ms var(--ease); touch-action: pan-y; cursor: grab; }
  .core:global(.on) canvas { opacity: 1; }
  .core:global(.off) { display: none; }
</style>
